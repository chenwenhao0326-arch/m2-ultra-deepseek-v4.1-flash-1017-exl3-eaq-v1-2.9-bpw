+        };
+        try testing.expect(first_wait < src.log.items.len);
+        if (applies) {
+            if (!rolling) try testing.expectEqual(@as(usize, 2), rr[0].n_calls) else try testing.expect(rr[0].n_calls >= 2);
+            try testing.expect(rr[0].calls[0].at <= first_wait);
+            const end = src.log.items[first_wait].at;
+            var early_evaluated = false;
+            for (g.evals.items) |ev| early_evaluated = early_evaluated or (ev > rr[0].calls[0].node and ev <= end);
+            try testing.expect(early_evaluated);
