+test "parked ext lifecycle: moves physical owners while policy and reloaded expert bytes match cold shrink" {
+    // The native reader is process-global. Replay each arm sequentially, preserving policy evidence.
+    const Replay = struct {
+        const Evidence = struct {
+            slots: [2][2][32]u16 = undefined,
+            freq: [2][2][32]u32 = undefined,
+            routes: u64 = 0,
+            misses: u64 = 0,
+        };
+        fn run(reuse: bool) !Evidence {
+            var sb = try SynthBank.open(32);
+            defer sb.close();
+            const s = try Stream.init(testing.allocator, &sb.bank, .{ .rows = &.{ 4, 2 }, .max_route_ids = 12, .transient_rows = 24, .wide_depth = 2, .pool = test_pool, .transient_release = true, .grow_fill = .unfilled });
+            defer s.deinit();
+            var out: Evidence = .{};
+            _ = try s.releaseTransient();
+            try s.grow(&.{ 12, 10 });
+            for (0..2) |layer| {
+                const r = try serve(s, @intCast(layer), &.{ 1, 2, 3, 4, 5, 6 });
+                try expectServed(s, &sb, r, &.{ 1, 2, 3, 4, 5, 6 });
+                s.release(r);
+            }
+            try s.flush();
+            const ptrs = [2][n_components]u64{ s.layers[0].ext.?.base, s.layers[1].ext.?.base };
+            const ext = try s.extPoolBytes();
+            try testing.expect(ext.logical > 0);
+            try testing.expectEqual(ext.logical, ext.backing);
+            const freed = if (reuse) try s.parkForPrompt(&.{ 4, 2 }, .keep) else try s.shrink(&.{ 4, 2 }, .keep);
+            const stats = s.poolReuseStats();
+            try testing.expectEqual(stats.transient_freed.backing + (if (reuse) @as(u64, 0) else ext.backing), freed);
+            if (reuse) {
+                try testing.expectEqual(ext, stats.parked);
+                try testing.expect(s.hasParked());
+                try testing.expectEqual(ext.backing, try s.parkedBytes());
+            }
+            for (s.layers, ptrs, 0..) |*ls, ptr, l| {
+                try testing.expect(ls.ext == null);
+                if (reuse) try testing.expectEqualSlices(u64, &ptr, &ls.parked_ext.?.base);
+                @memcpy(&out.slots[0][l], ls.policy.slot_to_expert);
+                @memcpy(&out.freq[0][l], ls.policy.prefill_freq);
+                for (ls.meta[ls.base.rows..]) |m| try testing.expect(m.state != .ready and m.pins == 0);
+            }
+            _ = try s.regrowTransient();
+            const r = try serve(s, 0, &.{ 7, 8, 9, 10, 11, 12 });
+            try expectServed(s, &sb, r, &.{ 7, 8, 9, 10, 11, 12 });
+            s.release(r);
+            try s.flush();
+            _ = try s.releaseTransient();
+            try s.grow(&.{ 12, 10 });
+            try testing.expect(!s.hasParked());
+            if (reuse) {
+                try testing.expectEqual(ext, s.poolReuseStats().reused);
+                try testing.expectEqual(@as(u64, 0), s.poolReuseStats().new.backing);
+            } else try testing.expectEqual(ext, s.poolReuseStats().new);
+            for (s.layers, ptrs, 0..) |*ls, ptr, l| {
+                if (reuse) try testing.expectEqualSlices(u64, &ptr, &ls.ext.?.base);
+                @memcpy(&out.slots[1][l], ls.policy.slot_to_expert);
+                @memcpy(&out.freq[1][l], ls.policy.prefill_freq);
