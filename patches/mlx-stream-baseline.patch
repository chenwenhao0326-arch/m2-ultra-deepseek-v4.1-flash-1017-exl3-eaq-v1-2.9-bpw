+test "C01 DEVROUTE: opt-in hook writes both LUTs and updates only next parity without changing miss join" {
+    const a = testing.allocator;
+    var c = testConfig(256, 128, 1);
+    c.n_routed_experts = 16;
+    var src = try FakeSource.init(a, .{ .hidden = 256, .inter = 128, .n_experts = 16, .rows = &.{4} });
+    defer src.deinit();
+    var g = TraceOps.init(a);
+    defer g.deinit();
+    g.record_host = true;
+    const Ex = ExpertsWith(TraceOps, FakeSource, TraceBankedMath, .{});
+    const math: TraceBankedMath = .{ .inner = .{ .hidden = 256, .inter = 128 } };
+    try testing.expectError(error.DevrouteSentinelNeedsDevroute, Ex.initWith(a, &g, &src, math, &c, .{ .banked = true, .devroute_skip_invalid = true }));
+    try testing.expectError(error.DevrouteNeedsBanked, Ex.initWith(a, &g, &src, math, &c, .{ .devroute = true, .devroute_skip_invalid = true }));
+    var ex = try Ex.initWith(a, &g, &src, math, &c, .{ .banked = true, .devroute = true, .devroute_skip_invalid = true });
+    defer ex.deinit();
+    try testing.expect(ex.devRouteSkipsInvalid());
+    try ex.grow(&g, &.{8});
+    for (ex.dev_lut[0]) |array| {
+        const got = std.mem.bytesAsSlice(u32, @as([]align(4) u8, @alignCast(try g.hostBytes(array))));
+        for (got) |v| try testing.expectEqual(expert_stream.invalid_devroute_ref, v);
+    }
+    var script: Script = .{ .calls = &.{ &.{ 0, 1, 2, 3, 4, 5 }, &.{ 0, 7, 0, 7, 9, 3 } } };
+    g.host_values = script.values();
+    const xf = try g.input(&.{ 2, 256 }, .bfloat16);
+    const idx = try g.input(&.{ 2, 3 }, .int32);
+    for (0..2) |_| {
+        const old_parity = ex.dev_parity[0];
+        var previous: [16]u32 = undefined;
+        @memcpy(&previous, std.mem.bytesAsSlice(u32, @as([]align(4) u8, @alignCast(try g.hostBytes(ex.dev_lut[0][old_parity])))));
+        const out = try ex.at(0).routedHoist(&g, xf, idx, &.{});
+        try testing.expect(g.shapeOf(out).eql(ops.Shape.of(&.{ 2, 3, 256 })));
+        try testing.expect(old_parity != ex.dev_parity[0]);
+        try testing.expectEqualSlices(u32, &previous, std.mem.bytesAsSlice(u32, @as([]align(4) u8, @alignCast(try g.hostBytes(ex.dev_lut[0][old_parity])))));
+        var expected: [16]u32 = undefined;
+        src.residentLutSkippingInvalid(0, &expected);
+        const got = std.mem.bytesAsSlice(u32, @as([]align(4) u8, @alignCast(try g.hostBytes(ex.dev_lut[0][ex.dev_parity[0]]))));
+        try testing.expectEqualSlices(u32, &expected, got);
+    }
+    try ex.flush();
+    var order: [max_route_ids]u32 = undefined;
+    _ = Ex.joinOrder(&.{ 0, 1, 2, 3, 4, 5, 1, 3, 4 }, 6, &order);
+    try testing.expectEqualSlices(u32, &.{ 0, 6, 2, 7, 8, 5 }, order[0..6]);
+}
