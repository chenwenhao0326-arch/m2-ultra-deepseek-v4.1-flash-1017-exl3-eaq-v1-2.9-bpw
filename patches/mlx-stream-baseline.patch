+//! Isolated C02 + compact dual-tile GU experiment. Default off.
+//! Only banked GU with18/24/30 assignments; separate cached kernels preserve the
+//! existing C02 entry at every other width. No persistent expert-slot ownership.
+const std = @import("std");
+const sdk = @import("sdk");
+const mlx = sdk.mlx;
+const mtl = @import("../sdk_ext/metal_launch.zig");
+const row_shapes = [_]u64{ 18, 24, 30 };
+
+pub fn slot(rows: u64) ?usize {
+    for (row_shapes, 0..) |n, i| if (rows == n) return i;
+    return null;
+}
+pub fn enabledValue(profile: bool, flag: ?[]const u8, c02: ?[]const u8) bool {
+    return profile and flag != null and c02 != null and std.mem.eql(u8, flag.?, "1") and std.mem.eql(u8, c02.?, "1");
+}
+pub fn enabled() bool {
+    const flag = if (std.c.getenv("DSV41_EXPERIMENT_GU_COMPACT_ROWS")) |s| std.mem.span(s) else null;
+    const c02 = if (std.c.getenv("DSV41_EXPERIMENT_GU_PAIR")) |s| std.mem.span(s) else null;
+    return enabledValue(sdk.plugin_profile, flag, c02);
+}
+
+pub fn Candidate(comptime G: type) type {
+    return struct {
+        const Self = @This();
+        pub const T = G.T;
+        kernels: [2]mlx.mlx_fast_metal_kernel = @splat(.{}), // k_index0=K3,1=K2
+        configs: [2][3]mlx.mlx_fast_metal_kernel_config = @splat(@splat(.{})),
