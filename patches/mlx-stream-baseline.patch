+    /// Rebind a settled, physically unchanged parked record at its original slot.
+    /// The stream validates readiness/ownership first. A newer base copy wins.
+    pub fn restoreReadyExpert(p: *LayerPolicy, slot: u32, expert: u16) !bool {
+        if (slot >= p.capacity or expert >= p.n_experts) return error.InvalidRestoredSlot;
+        if (p.slot_to_expert[slot] != no_expert) return error.RestoredSlotOccupied;
+        if (p.expert_to_slot[expert] != no_slot) return false;
+        p.slot_to_expert[slot] = expert;
+        p.expert_to_slot[expert] = slot;
+        p.occupancy += 1;
+        p.recency[expert] = if (p.last_used[expert] >= 0) @intCast(p.last_used[expert] + 1) else 0;
+        p.clock = @max(p.clock, p.recency[expert]);
+        return true;
+    }
