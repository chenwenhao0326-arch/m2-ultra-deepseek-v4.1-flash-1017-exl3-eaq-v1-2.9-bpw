+/// Native request-local bound for an ext pool retained but invisible to the prompt policy.
+/// Only prompt wave changes; every full-context KV/state/image/cache term stays admitted.
+pub fn parkedPromptBill(full: Bill, pb: v41.PrefillBill, layer_major: bool, joinless: bool, ext_logical: u64, ext_backing: u64) !Bill {
+    const pe = @import("parked_ext.zig");
+    var wave: u64 = 0;
+    for (1..pe.max_prompt_tokens + 1) |n| {
+        wave = @max(wave, promptWave(pb, layer_major, joinless, n));
+        wave = @max(wave, turnCallWave(pb, layer_major, joinless, n, n));
+    }
+    return parkedBillWithWave(full, ext_logical, ext_backing, wave);
+}
+
+/// A proven prefix reuse: query width and key/history length are distinct.
+/// Enumerate all smaller call widths too (chunk/dispatch knees need not be monotone).
+pub fn parkedQueryBill(full: Bill, pb: v41.PrefillBill, layer_major: bool, joinless: bool, ext_logical: u64, ext_backing: u64, query: @import("parked_ext.zig").Query) !Bill {
+    const pe = @import("parked_ext.zig");
+    if (query.rows == 0 or query.rows > pe.max_prompt_tokens or query.positions < query.rows or query.positions > settings.Config.max_ctx_size) return error.ParkedQueryGeometry;
+    var wave: u64 = 0;
+    var n: u64 = 1;
+    while (n <= query.rows) : (n += 1) {
+        wave = @max(wave, promptWave(pb, layer_major, joinless, n));
+        wave = @max(wave, turnCallWave(pb, layer_major, joinless, n, query.positions));
+    }
+    return parkedBillWithWave(full, ext_logical, ext_backing, wave);
+}
+
+fn parkedBillWithWave(full: Bill, ext_logical: u64, ext_backing: u64, wave: u64) !Bill {
+    const rounding = @as(u64, full.layers) * expert_bank.n_components * module.grow_alloc_round_bytes;
+    if (full.decode_rows < full.prefill_rows) return error.ParkedBackingGeometry;
+    const expected = @as(u64, full.decode_rows - full.prefill_rows) * full.persistentRowBytes();
+    if (ext_logical != expected or ext_backing < ext_logical or ext_backing > ext_logical + rounding) return error.ParkedBackingGeometry;
+    var b = full;
+    b.prefill_wave = wave;
+    b.prefill_wave_tight = wave; // no tighter unproved bound for the optional route
+    b.slot_prefill += ext_logical + rounding; // full decode and metadata already charged by billAt when gate is installed
+    return b;
+}
