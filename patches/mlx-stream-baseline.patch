+//! Complete native text-state persistence. Uses existing typed safetensors I/O.
+//! No precision conversion, dropped SWA, speculative state, raw handles or model weights.
+const std = @import("std");
+const sdk = @import("sdk");
+const mlx = sdk.mlx;
+const G = @import("ops.zig").MlxOps;
+const M = @import("model.zig").Model(G);
+const H = @import("dspark_head.zig").Head(G);
+const L = @import("cache.zig").Lanes(G);
+const tokens = @import("committed_tokens.zig");
+const cwd = std.Io.Dir.cwd;
+const meta_key = "native_dsv41_state";
+pub const schema: u32 = 1;
+pub const max_entries: usize = 8;
+pub const max_file_bytes: u64 = 2 << 30;
