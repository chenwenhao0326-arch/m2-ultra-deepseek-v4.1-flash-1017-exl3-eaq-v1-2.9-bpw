+    var c = try @import("host.zig").loadConfig(testing.io, a, dir);
+    const raw = try std.Io.Dir.cwd().readFileAlloc(testing.io, settings_path, a, .limited(1 << 20));
+    const doc = try std.json.parseFromSliceLeaky(std.json.Value, a, raw, .{});
+    c.applySettings(doc.object.get(dir) orelse return error.ModelSettingsMissing);
+    c.expert_prefill_rows = 128;
+    c.expert_rows = 184;
+    c.max_context_tokens = 262144;
+    c.memory_baseline_bytes = 0;
+    c.vision_enabled = false;
