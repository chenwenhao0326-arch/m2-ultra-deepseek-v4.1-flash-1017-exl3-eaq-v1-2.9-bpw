new file mode 100644
index 0000000..fdb06d1
--- /dev/null
+++ b/src/arch/deepseek_v41/vision_inputs.zig
@@ -0,0 +1,113 @@
+//! Borrowed image rows at absolute sequence positions. No array is retained here:
+//! the request owns `Rows.rows`, and the op backend owns all derived arrays.
+const std = @import("std");
+const ops = @import("ops.zig");
+
+pub fn Rows(comptime T: type) type {
+    return struct { rows: T, offset: u64 };
+}
+
+/// Check placement before building a graph or advancing the Engram history.
+/// A chunk can overlap only part of the image span; offsets are never chunk-local.
+pub fn overlap(comptime G: type, g: *G, visual: Rows(G.T), offset: u64, ids: []const u32, image_id: u32, width: u32) !?[2]u64 {
+    const s = g.shapeOf(visual.rows);
+    if (s.n != 3 or s.d[0] != 1 or s.d[1] <= 0 or s.d[2] != width or !ops.isFloat(g.dtypeOf(visual.rows))) return error.VisionRowsShape;
+    const end = std.math.add(u64, visual.offset, @intCast(s.d[1])) catch return error.VisionOffsetOverflow;
+    const chunk_end = std.math.add(u64, offset, ids.len) catch return error.VisionOffsetOverflow;
+    for (ids, 0..) |id, i| {
+        const at = offset + i;
+        if ((id == image_id) != (at >= visual.offset and at < end)) return error.VisionTokenMismatch;
+    }
+    const lo = @max(offset, visual.offset);
+    const hi = @min(chunk_end, end);
+    return if (lo < hi) .{ lo, hi } else null;
+}
+
+pub fn splice(comptime G: type, g: *G, visual: ?Rows(G.T), offset: u64, ids: []const u32, image_id: u32, width: u32, text: G.T) !G.T {
+    const v = visual orelse return text;
+    const span = (try overlap(G, g, v, offset, ids, image_id, width)) orelse return text;
+    const ts = g.shapeOf(text);
+    if (ts.n != 3 or ts.d[0] != 1 or ts.d[1] != ids.len or ts.d[2] != width) return error.VisionTextShape;
+    const lo: c_int = @intCast(span[0] - offset);
+    const hi: c_int = @intCast(span[1] - offset);
+    const vlo: c_int = @intCast(span[0] - v.offset);
+    const vhi: c_int = @intCast(span[1] - v.offset);
+    const dim: c_int = @intCast(width);
+    var pieces: [3]G.T = undefined;
+    var n: usize = 0;
+    if (lo > 0) {
+        pieces[n] = try g.slice(text, &.{ 0, 0, 0 }, &.{ 1, lo, dim }, &.{ 1, 1, 1 });
+        n += 1;
+    }
+    pieces[n] = try g.astype(try g.slice(v.rows, &.{ 0, vlo, 0 }, &.{ 1, vhi, dim }, &.{ 1, 1, 1 }), g.dtypeOf(text));
+    n += 1;
+    if (hi < ts.d[1]) {
+        pieces[n] = try g.slice(text, &.{ 0, hi, 0 }, &.{ 1, ts.d[1], dim }, &.{ 1, 1, 1 });
+        n += 1;
+    }
+    return if (n == 1) pieces[0] else g.concat(pieces[0..n], 1);
+}
+
+/// Null is the allocation-free text path. The caller owns the host mask.
+pub fn hostMask(a: std.mem.Allocator, ids: []const u32, image_id: u32) !?[]bool {
+    if (std.mem.indexOfScalar(u32, ids, image_id) == null) return null;
+    const out = try a.alloc(bool, ids.len);
+    for (ids, out) |id, *v| v.* = id == image_id;
+    return out;
+}
+
+pub fn deviceMask(comptime G: type, g: *G, mask: ?[]const bool) !?G.T {
+    const m = mask orelse return null;
+    return try g.hostArray(std.mem.sliceAsBytes(m), &.{@intCast(m.len)}, .bool_);
+}
+
+/// Image positions carry their incoming hidden state, without the text Engram add.
+pub fn bypassEngram(comptime G: type, g: *G, mask: ?G.T, before: G.T, after: G.T) !G.T {
+    const m = mask orelse return after;
+    return g.where(try g.reshape(m, &.{ 1, -1, 1, 1 }), before, after);
+}
+
+test "dsv41 vision inputs: absolute chunk splice preserves text and image rows numerically" {
+    _ = std.c.getenv("DSV41_VISION_MLX") orelse return error.SkipZigTest;
+    const mlx = @import("sdk").mlx;
+    const s = mlx.mlx_default_cpu_stream_new();
+    defer _ = mlx.mlx_stream_free(s);
+    var g = try ops.MlxOps.init(std.testing.allocator, s);
+    defer g.deinit();
+    const G = ops.MlxOps;
+    const visual = try g.hostArray(std.mem.sliceAsBytes(&[_]f32{ 10, 11, 20, 21, 30, 31 }), &.{ 1, 3, 2 }, .float32);
+    const text = try g.hostArray(std.mem.sliceAsBytes(&[_]f32{ 1, 2, 3, 4, 5, 6, 7, 8, 9, 0 }), &.{ 1, 5, 2 }, .float32);
+    const ids = [_]u32{ 4, 99, 99, 99, 5 };
+    const v: Rows(G.T) = .{ .rows = visual, .offset = 8 };
+    const whole = try splice(G, &g, v, 7, &ids, 99, 2, text);
+    const a = try splice(G, &g, v, 7, ids[0..2], 99, 2, try g.slice(text, &.{ 0, 0, 0 }, &.{ 1, 2, 2 }, &.{ 1, 1, 1 }));
+    const b = try splice(G, &g, v, 9, ids[2..5], 99, 2, try g.slice(text, &.{ 0, 2, 0 }, &.{ 1, 5, 2 }, &.{ 1, 1, 1 }));
+    const chunks = try g.concat(&.{ a, b }, 1);
+    const expected = [_]f32{ 1, 2, 10, 11, 20, 21, 30, 31, 9, 0 };
+    var whole_data: [10]f32 = undefined;
+    var chunk_data: [10]f32 = undefined;
+    try std.testing.expectEqualSlices(f32, &expected, try g.hostF32(whole, &whole_data));
+    try std.testing.expectEqualSlices(f32, &expected, try g.hostF32(chunks, &chunk_data));
+    const mark = g.mark();
+    _ = try splice(G, &g, null, 7, &ids, 99, 2, text);
+    try std.testing.expectEqual(mark, g.mark());
+    try std.testing.expectError(error.VisionTokenMismatch, splice(G, &g, v, 7, &.{ 4, 99, 7, 99, 5 }, 99, 2, text));
+    try std.testing.expectError(error.VisionRowsShape, splice(G, &g, v, 7, &ids, 99, 3, text));
+    try std.testing.expectEqual(mark, g.mark());
+}
+
+test "dsv41 vision inputs: mask bypass leaves image hidden rows unchanged" {
+    _ = std.c.getenv("DSV41_VISION_MLX") orelse return error.SkipZigTest;
+    const mlx = @import("sdk").mlx;
+    const s = mlx.mlx_default_cpu_stream_new();
+    defer _ = mlx.mlx_stream_free(s);
+    var g = try ops.MlxOps.init(std.testing.allocator, s);
+    defer g.deinit();
+    const mask = (try hostMask(std.testing.allocator, &.{ 1, 99, 2 }, 99)).?;
+    defer std.testing.allocator.free(mask);
+    const before = try g.hostArray(std.mem.sliceAsBytes(&[_]f32{ 1, 2, 3, 4, 5, 6 }), &.{ 1, 3, 1, 2 }, .float32);
+    const after = try g.add(before, try g.scalar(10, .float32));
+    const out = try bypassEngram(ops.MlxOps, &g, try deviceMask(ops.MlxOps, &g, mask), before, after);
+    var data: [6]f32 = undefined;
+    try std.testing.expectEqualSlices(f32, &.{ 11, 12, 3, 4, 15, 16 }, try g.hostF32(out, &data));
+}
