+        } else if (m.hash_capacity != 0 or m.boundary_hash_len != 0) return error.EngramState;
+        if (m.ledger_capacity < m.ledger_ids.len or m.ledger_capacity > 2 * @as(u64, l.max_kv) + 1024 or (m.ledger_valid and m.ledger_ids.len != m.offset)) return error.LedgerState;
+        for (m.ids) |x| if (x >= l.vocab) return error.TokenId;
+        for (m.ledger_ids) |x| if (x >= l.vocab) return error.TokenId;
+        for (m.layers, m.boundary_layers, l.layers) |s, b, c| {
+            if (s.offset != m.offset or b.offset != m.boundary_offset or s.window_size != l.window or s.ratio != c.ratio or s.kv_source != c.kv_source or s.bounded_max_kv != l.max_kv or b.compress > s.compress.len or b.index > s.index.len) return error.LayerGeometry;
+            try v.ring(s.window, l.head_dim, .BF16, l.window, s.offset);
+            try v.grow(s.compress, l.head_dim, .BF16, s.ratio);
+            try v.grow(s.index, l.index_dim, .F32, s.ratio);
