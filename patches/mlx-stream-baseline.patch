+    if (prior) |p| for (p.value.entries) |old| {
+        const kept = for (entries.items) |e| {
+            if (std.mem.eql(u8, e.file_sha, old.file_sha)) break true;
+        } else false;
+        if (!kept) {
+            const path = try filePath(a, opt, old.file_sha);
+            defer a.free(path);
+            cwd().deleteFile(io, path) catch {};
+        }
+    };
+}
