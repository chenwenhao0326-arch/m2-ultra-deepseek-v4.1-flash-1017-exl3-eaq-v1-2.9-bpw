+test "dsv41 vision lifecycle: request lease survives host release and clears its borrow on failure" {
+    const TG = ops.TraceOps;
+    const TM = struct {
+        pub const VisionRows = struct { rows: TG.T, offset: u64 };
+        vision: ?VisionRows = null,
+    };
+    var g = TG.init(std.testing.allocator);
+    defer g.deinit();
+    g.track_live = true;
+    var model: TM = .{};
+    const input = g.keep(try g.input(&.{ 1, 4, 32 }, .bfloat16));
+    var lease = VisionLease(TG, TM).init(&g, &model, .{ .rows = input, .offset = 3 });
+    try std.testing.expect(model.vision == null); // Previous-request cleanup runs before bind.
+    g.release(input); // The host Slot can now release its independent handle.
+    try std.testing.expectEqual(@as(i32, 1), g.live_kept.get(input).?);
+    lease.bind();
+    try std.testing.expectEqual(@as(u64, 3), model.vision.?.offset);
+    lease.deinit(); // Same cleanup used by defer on every return, including failure.
+    try std.testing.expect(model.vision == null);
+    try std.testing.expectEqual(@as(i32, 0), g.live_kept.get(input).?);
+    lease.deinit(); // Clearing twice never releases the array twice.
+    try std.testing.expectEqual(@as(i32, 0), g.live_kept.get(input).?);
+    var text = VisionLease(TG, TM).init(&g, &model, null);
+    text.bind();
+    text.deinit();
+    try std.testing.expect(model.vision == null);
+}
