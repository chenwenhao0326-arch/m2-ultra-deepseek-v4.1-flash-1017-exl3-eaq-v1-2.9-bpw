+    fn note(self: *@This(), g: *TraceOps, rows: quant.PrefillRows) !void {
+        const i = self.n_calls;
+        self.calls[i] = .{ .at = source.?.log.items.len, .node = g.nodes.items.len, .rows = rows.slot.len };
+        self.n_calls += 1;
+        if (self.fail_call == i) return error.HitsFirstTestCall;
+    }
+    pub fn call(self: *@This(), g: *TraceOps, act: u32, rows: quant.PrefillRows, bank: BankArraysOf(u32)) !u32 {
+        try self.note(g, rows);
+        var inner: EncRoute = .{};
+        return g.keep(try inner.call(g, act, rows, bank));
+    }
+    pub fn callParts(self: *@This(), g: *TraceOps, act: u32, rows: quant.PrefillRows, bank: BankArraysOf(u32), a: std.mem.Allocator, outs: *std.ArrayList(u32), pos: *std.ArrayList(u32)) !void {
+        try self.note(g, rows);
+        var inner: EncRoute = .{};
+        const before = outs.items.len;
+        try inner.callParts(g, act, rows, bank, a, outs, pos);
+        for (outs.items[before..]) |x| _ = g.keep(x);
+    }
+    pub fn finish(self: *@This(), _: *TraceOps) !void {
+        const i = self.n_finishes;
+        self.n_finishes += 1;
+        if (self.fail_finish == i) return error.HitsFirstTestFinish;
+        // The loop also calls finish for empty groups, so count actual math calls.
+        // Both early and miss work have finished. Preallocated eval bookkeeping leaves
+        // the next allocation in runWide/runWideParts' post-Core ownership window.
+        if (self.n_calls == 2 and !self.oom_armed) {
+            self.oom_armed = true;
+            if (self.graph_oom) |fa| {
+                fa.fail_index = fa.alloc_index + self.oom_after;
+                fa.resize_fail_index = fa.resize_index;
+            }
+            if (self.owner_oom) |fa| {
+                fa.fail_index = fa.alloc_index + self.oom_after;
+                fa.resize_fail_index = fa.resize_index;
+            }
+        }
+    }
