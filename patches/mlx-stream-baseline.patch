+/// Construction forwards are not training traffic. Discard their counters before
+/// a persisted file is installed, without changing its future learned rates.
+pub fn discardRequestCounts(policy: anytype) void {
+    @memset(policy.request_counts, 0);
+    policy.request_routes = 0;
+}
+
+/// Request transition and shutdown share this one fold. An already-flushed
+/// request (or construction without user traffic) neither folds EMA nor writes.
+pub fn endPending(stream: anytype, out: []f32) u32 {
+    var pending = false;
+    for (stream.layers) |layer| pending = pending or layer.policy.request_routes > 0;
+    if (!pending) return 0;
+    return stream.endTally(out);
+}
+
+/// No statistical evidence means no preload candidate, even if capacity remains.
+pub fn positiveOrder(rates: []const f32, out: []u16) []const u16 {
