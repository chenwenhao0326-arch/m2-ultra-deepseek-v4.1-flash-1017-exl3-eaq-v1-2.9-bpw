+    const steps = [_]u32{ 64, 64 };
+    for (steps) |n| {
+        for (state.layers, 0..) |*lc, i| {
+            const dt: mlx.mlx_dtype = if (i % 2 == 0) .bfloat16 else .float32;
+            try lc.window.append(&g, try testRows(a, &g, n, model.c.head_dim, @intCast(state.offset * 7 + i * 11), dt));
+            if (lc.kv_source and lc.ratio > 0) {
