+        for (v.boundary.state.layers, bs) |b, *o| o.* = .{ .offset = b.offset, .window = try e.snap(b.window), .compress = b.compress, .index = b.index, .frontier = if (b.frontier) |f| .{ .kv = try e.snap(f.kv), .score = try e.snap(f.score) } else null };
