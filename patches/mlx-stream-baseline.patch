+        const bytes = g.hostBytesOf(result.outs[si]) orelse return error.NoHostBytes;
+        const values = std.mem.bytesAsSlice(f32, @as([]align(4) const u8, @alignCast(bytes)));
+        if (values[row * 64] != @as(f32, @floatFromInt(q / k))) bad_token_rows += 1;
