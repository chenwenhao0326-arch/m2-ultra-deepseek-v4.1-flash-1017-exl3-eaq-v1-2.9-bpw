+    }
+    fn grow(e: *Export, s: L.Store) !Grow {
+        return switch (s) {
+            .grow => |v| .{ .buf = try e.add(v.buf), .len = v.len, .cap = v.cap, .init_cap = v.init_cap, .bounded_cap = v.bounded_cap orelse return error.UnboundedState },
