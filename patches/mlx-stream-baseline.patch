+//! Diagnostic candidate only; no approximate prediction or record cancellation.
+const std = @import("std");
+const sdk = @import("sdk");
+pub const reserve_bytes: u64 = 512 << 10; // bounded actual-ID observer plus record ownership metadata.
+pub fn enabled() bool {
+    if (comptime !sdk.plugin_profile) return false;
+    const raw = std.c.getenv("DSV41_EXPERIMENT_SELECTIVE_AHEAD") orelse return false;
+    return accepts(std.mem.span(raw));
+}
+fn accepts(raw: []const u8) bool {
+    return std.mem.eql(u8, raw, "1");
+}
+test "dsv41 selective ahead: only explicit one enables the candidate" {
+    try std.testing.expect(accepts("1"));
+    for ([_][]const u8{ "", "0", "true", "01", "1 ", "-1" }) |v| try std.testing.expect(!accepts(v));
+}
