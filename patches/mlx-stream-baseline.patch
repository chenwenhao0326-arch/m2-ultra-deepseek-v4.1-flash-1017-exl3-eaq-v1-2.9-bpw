+    }
+    fn boundary(v: *Import, m: *const Manifest) !Boundary {
+        const ls = try v.a.alloc(M.Cache.Boundary, m.boundary_layers.len);
+        var n: usize = 0;
+        errdefer {
+            for (ls[0..n]) |*x| x.deinit(v.g);
+            v.a.free(ls);
+        }
+        for (m.boundary_layers) |b| {
+            ls[n] = try v.bound(b);
+            n += 1;
+        }
+        const ids = try v.a.dupe(u32, m.ids);
+        errdefer v.a.free(ids);
+        const cs = try v.a.alloc(H.Cache, m.draft.len);
+        for (cs) |*c| c.* = .{};
+        errdefer {
+            for (cs) |*c| c.deinit(v.g);
+            v.a.free(cs);
+        }
+        for (m.draft, cs) |d, *c| c.* = .{ .offset = d.offset, .window = try v.get(d.window) };
+        return .{ .ids = ids, .state = .{ .offset = m.boundary_offset, .layers = ls, .hash_len = m.boundary_hash_len }, .caches = cs, .main_h = try v.get(m.main_h), .vision = m.vision, .seeded = m.seeded };
+    }
+    fn image(v: *Import, m: *const Manifest) !Image {
+        var st = try v.state(m);
+        errdefer st.deinit(v.g, v.a);
+        var b = try v.boundary(m);
+        errdefer b.deinit(v.g, v.a);
+        var ll: ledger.Ledger = .{};
+        errdefer ll.deinit(v.a);
+        try ll.ids.ensureTotalCapacityPrecise(v.a, m.ledger_capacity);
+        try ll.ids.appendSlice(v.a, m.ledger_ids);
+        ll.valid = m.ledger_valid;
+        return .{ .state = st, .boundary = b, .committed = ll };
+    }
+};
+fn hex(bytes: [32]u8) [64]u8 {
+    var out: [64]u8 = undefined;
+    const h = "0123456789abcdef";
+    for (bytes, 0..) |b, i| {
+        out[2 * i] = h[b >> 4];
+        out[2 * i + 1] = h[b & 15];
+    }
+    return out;
+}
+fn hashFile(io: std.Io, file: std.Io.File) !struct { size: u64, digest: [32]u8 } {
+    const size = (try file.stat(io)).size;
+    if (size > record_limit or size < 8) return error.RecordTooLarge;
+    var sha = SHA.init(.{});
+    var buf: [64 << 10]u8 = undefined;
+    var at: u64 = 0;
+    while (at < size) {
+        const n: @TypeOf(buf.len) = @intCast(@min(size - at, buf.len));
+        if (try file.readPositionalAll(io, buf[0..n], at) != n) return error.ShortRead;
+        sha.update(buf[0..n]);
+        at += n;
+    }
+    if ((try file.stat(io)).size != size) return error.FileChanged;
+    return .{ .size = size, .digest = sha.finalResult() };
+}
+/// A fixed project-local namespace. Caller cannot supply arbitrary filenames or a path outside the project.
+pub const Root = struct {
+    a: std.mem.Allocator,
+    io: std.Io,
+    dir: std.Io.Dir,
+    path: []u8,
+    identity: Identity,
+    pub fn open(a: std.mem.Allocator, io: std.Io, project: []const u8, id: Identity) !Root {
+        if (!std.fs.path.isAbsolute(project) or id.format != 1) return error.CacheRoot;
+        var pd = try std.Io.Dir.openDirAbsolute(io, project, .{});
+        defer pd.close(io);
+        var pb: [std.fs.max_path_bytes]u8 = undefined;
+        const real = pb[0..try pd.realPath(io, &pb)];
+        const txt = try std.json.Stringify.valueAlloc(a, id, .{});
+        defer a.free(txt);
+        var hash: [32]u8 = undefined;
+        SHA.hash(txt, &hash, .{});
+        const ns = hex(hash);
+        const rel = try std.fmt.allocPrint(a, "state/deepseek-native-session-v1/{s}", .{ns});
+        defer a.free(rel);
+        var dir = try pd.createDirPathOpen(io, rel, .{});
+        errdefer dir.close(io);
+        var rb: [std.fs.max_path_bytes]u8 = undefined;
+        const root = rb[0..try dir.realPath(io, &rb)];
+        if (root.len <= real.len or !std.mem.startsWith(u8, root, real) or root[real.len] != '/') return error.CacheEscapesProject;
+        return .{ .a = a, .io = io, .dir = dir, .path = try a.dupe(u8, root), .identity = id };
+    }
+    pub fn deinit(r: *Root) void {
+        r.dir.close(r.io);
+        r.a.free(r.path);
+    }
+    /// Only state.safetensors + manifest.json under a new private staging directory; rename commits the whole entry.
+    pub fn save(r: *Root, key: [32]u8, image: *const Image, layout: Layout) !void {
+        const workspace = try r.a.alloc(u8, metadata_workspace_bytes);
+        defer r.a.free(workspace);
+        var fixed = std.heap.FixedBufferAllocator.init(workspace);
+        const a = fixed.allocator();
+        var ex: Export = .{ .a = a };
+        var m = try ex.capture(image, r.identity);
+        try validate(a, &m, layout, r.identity);
+        const final = hex(key);
+        var nonce: [8]u8 = undefined;
+        r.io.random(&nonce);
+        const tmp = try std.fmt.allocPrint(a, ".{s}.tmp-{x}", .{ final, std.mem.readInt(u64, &nonce, .little) });
+        if (r.dir.statFile(r.io, &final, .{})) |_| return error.EntryExists else |err| if (err != error.FileNotFound) return err;
+        try r.dir.createDir(r.io, tmp, .default_dir);
+        var d = try r.dir.openDir(r.io, tmp, .{});
+        defer d.close(r.io);
+        errdefer r.dir.deleteTree(r.io, tmp) catch {};
+        const path = try std.fmt.allocPrintSentinel(a, "{s}/{s}/state.safetensors", .{ r.path, tmp }, 0);
+        const map = mlx.mlx_map_string_to_array_new();
+        defer _ = mlx.mlx_map_string_to_array_free(map);
+        const meta = mlx.mlx_map_string_to_string_new();
+        defer _ = mlx.mlx_map_string_to_string_free(meta);
+        for (ex.arrays.items, 0..) |arr, i| {
+            var name: [40]u8 = undefined;
+            const n = try std.fmt.bufPrintSentinel(&name, "a{d}", .{i}, 0);
+            try mlx.check(mlx.mlx_map_string_to_array_insert(map, n, arr));
+        }
+        try mlx.check(mlx.mlx_save_safetensors(path, map, meta));
+        {
+            const f = try d.openFile(r.io, "state.safetensors", .{});
+            defer f.close(r.io);
+            const h = try hashFile(r.io, f);
+            m.payload_bytes = h.size;
+            m.payload_sha256 = h.digest;
+            try f.sync(r.io);
+        }
+        const json = try std.json.Stringify.valueAlloc(a, m, .{});
+        if (json.len > metadata_limit or m.payload_bytes + json.len > record_limit) return error.RecordTooLarge;
+        {
+            const f = try d.createFile(r.io, "manifest.json", .{});
+            defer f.close(r.io);
+            try f.writePositionalAll(r.io, json, 0);
+            try f.sync(r.io);
+        }
+        var manifest_digest: [32]u8 = undefined;
+        SHA.hash(json, &manifest_digest, .{});
+        {
+            const f = try d.createFile(r.io, "manifest.sha256", .{});
+            defer f.close(r.io);
+            try f.writePositionalAll(r.io, &manifest_digest, 0);
+            try f.sync(r.io);
+        }
+        try r.dir.rename(tmp, r.dir, &final, r.io);
+    }
+    /// All validation and materialization completes before a caller receives any state to install.
+    /// Caller must reserve record_limit+staging_reserve before calling; the current session is never touched here.
+    pub fn load(r: *Root, g: *G, key: [32]u8, layout: Layout) !Image {
+        const name = hex(key);
+        var d = try r.dir.openDir(r.io, &name, .{});
+        defer d.close(r.io);
+        var pb: [std.fs.max_path_bytes]u8 = undefined;
+        const real = pb[0..try d.realPath(r.io, &pb)];
+        if (real.len <= r.path.len or !std.mem.startsWith(u8, real, r.path) or real[r.path.len] != '/') return error.CacheEscapesProject;
+        const workspace = try r.a.alloc(u8, metadata_workspace_bytes);
+        defer r.a.free(workspace);
+        var fixed = std.heap.FixedBufferAllocator.init(workspace);
+        const a = fixed.allocator();
+        const json = try d.readFileAlloc(r.io, "manifest.json", a, .limited(metadata_limit));
+        var saved_digest: [32]u8 = undefined;
+        {
+            const f = try d.openFile(r.io, "manifest.sha256", .{});
+            defer f.close(r.io);
+            if ((try f.stat(r.io)).size != 32 or try f.readPositionalAll(r.io, &saved_digest, 0) != 32) return error.BadManifestChecksum;
+        }
+        var digest: [32]u8 = undefined;
+        SHA.hash(json, &digest, .{});
+        if (!std.mem.eql(u8, &saved_digest, &digest)) return error.BadManifestChecksum;
+        const parsed = try std.json.parseFromSlice(Manifest, a, json, .{ .ignore_unknown_fields = false });
+        defer parsed.deinit();
+        const m = &parsed.value;
+        if (m.payload_bytes + json.len > record_limit) return error.RecordTooLarge;
+        try validate(a, m, layout, r.identity);
+        {
+            const f = try d.openFile(r.io, "state.safetensors", .{});
+            defer f.close(r.io);
+            const h = try hashFile(r.io, f);
+            if (h.size != m.payload_bytes) return error.ShortRead;
+            if (!std.mem.eql(u8, &h.digest, &m.payload_sha256)) return error.BadChecksum;
+            try validateHeader(a, r.io, f, m);
+        }
+        const path = try std.fmt.allocPrintSentinel(r.a, "{s}/state.safetensors", .{real}, 0);
+        defer r.a.free(path);
+        var map = mlx.mlx_map_string_to_array_new();
+        defer _ = mlx.mlx_map_string_to_array_free(map);
+        var meta = mlx.mlx_map_string_to_string_new();
+        defer _ = mlx.mlx_map_string_to_string_free(meta);
+        const cpu = mlx.mlx_default_cpu_stream_new();
+        defer _ = mlx.mlx_stream_free(cpu);
+        try mlx.check(mlx.mlx_load_safetensors(&map, &meta, path, cpu));
+        // Header was validated before MLX constructs arrays; check native metadata again before evaluation.
+        for (m.arrays, 0..) |want, i| {
+            var buf: [40]u8 = undefined;
+            const n = try std.fmt.bufPrintSentinel(&buf, "a{d}", .{i}, 0);
+            var arr = mlx.mlx_array_new();
+            defer _ = mlx.mlx_array_free(arr);
+            try mlx.check(mlx.mlx_map_string_to_array_get(&arr, map, n));
+            const sh = mlx.getShape(arr);
+            if (sh.len != 3) return error.TensorShape;
+            for (sh, want.shape) |x, y| if (x < 0 or x != y) return error.TensorShape;
+            if (mlx.mlx_array_dtype(arr) != (if (want.dtype == .BF16) mlx.mlx_dtype.bfloat16 else .float32)) return error.TensorDtype;
+        }
+        var im: Import = .{ .a = r.a, .g = g, .map = map };
+        return im.image(m);
+    }
+};
+fn validateHeader(a: std.mem.Allocator, io: std.Io, f: std.Io.File, m: *const Manifest) !void {
+    var nbuf: [8]u8 = undefined;
+    if (try f.readPositionalAll(io, &nbuf, 0) != 8) return error.ShortRead;
+    const n = std.mem.readInt(u64, &nbuf, .little);
+    if (n > metadata_limit or n + 8 > m.payload_bytes) return error.TensorHeader;
+    const text = try a.alloc(u8, @intCast(n));
+    defer a.free(text);
+    if (try f.readPositionalAll(io, text, 8) != n) return error.ShortRead;
+    const parsed = try std.json.parseFromSlice(std.json.Value, a, text, .{});
+    defer parsed.deinit();
+    if (parsed.value != .object) return error.TensorHeader;
+    const obj = parsed.value.object;
+    if (obj.count() != m.arrays.len + @as(usize, if (obj.contains("__metadata__")) 1 else 0)) return error.TensorCount;
+    var ranges: std.ArrayList([2]u64) = .empty;
+    defer ranges.deinit(a);
+    for (m.arrays, 0..) |want, i| {
+        var buf: [40]u8 = undefined;
+        const name = try std.fmt.bufPrint(&buf, "a{d}", .{i});
+        const v = obj.get(name) orelse return error.TensorMissing;
+        if (v != .object) return error.TensorHeader;
+        const dtype = v.object.get("dtype") orelse return error.TensorHeader;
+        if (dtype != .string or !std.mem.eql(u8, dtype.string, @tagName(want.dtype))) return error.TensorDtype;
+        const shape = v.object.get("shape") orelse return error.TensorHeader;
+        if (shape != .array or shape.array.items.len != 3) return error.TensorShape;
+        for (shape.array.items, want.shape) |x, y| if (x != .integer or x.integer < 0 or x.integer != y) return error.TensorShape;
+        const offsets = v.object.get("data_offsets") orelse return error.TensorHeader;
+        if (offsets != .array or offsets.array.items.len != 2) return error.TensorHeader;
+        var pair: [2]u64 = undefined;
+        for (offsets.array.items, &pair) |x, *y| {
+            if (x != .integer or x.integer < 0) return error.TensorHeader;
+            y.* = @intCast(x.integer);
+        }
+        if (pair[1] < pair[0] or pair[1] - pair[0] != want.bytes or pair[1] > m.payload_bytes - 8 - n) return error.TensorSize;
+        try ranges.append(a, pair);
+    }
+    std.mem.sort([2]u64, ranges.items, {}, struct {
+        fn less(_: void, x: [2]u64, y: [2]u64) bool {
+            return x[0] < y[0];
+        }
+    }.less);
+    var end: u64 = 0;
+    for (ranges.items) |pair| {
+        if (pair[0] != end) return error.TensorOverlap;
+        end = pair[1];
+    }
+    if (end + 8 + n != m.payload_bytes) return error.TensorSize;
+}
+
+fn syntheticArray(g: *G, rows: u32, width: u32, dt: mlx.mlx_dtype, seed: f32) !G.T {
+    var vals: [128]f32 = undefined;
+    const n = rows * width;
+    if (n > vals.len) return error.TestShape;
+    for (vals[0..n], 0..) |*x, i| x.* = seed + @as(f32, @floatFromInt(i)) / 8;
+    const raw = try g.hostArray(std.mem.sliceAsBytes(vals[0..n]), &.{ 1, @intCast(rows), @intCast(width) }, .float32);
+    return g.keep(try g.astype(raw, dt));
+}
+fn syntheticRing(g: *G, width: u32, window: u32, offset: u32, dt: mlx.mlx_dtype) !L.Ring {
+    var r: L.Ring = .{ .window = window, .cap_keep = window, .phys_cap = 8, .base_phys_cap = 8, .caps = .{ 8, 8 }, .cur = 0, .len = offset, .drop = 0 };
+    errdefer r.deinit(g);
+    r.bufs[0] = try syntheticArray(g, 8, width, dt, 1);
+    r.bufs[1] = try syntheticArray(g, 8, width, dt, 20);
+    return r;
+}
+const test_contract = [_]LayerContract{.{ .ratio = 2, .kv_source = true }};
+const test_layout: Layout = .{ .layers = &test_contract, .window = 4, .head_dim = 4, .index_dim = 2, .main_dim = 8, .stages = 1, .max_kv = 16, .scratch_bytes = 32, .has_engram = true, .vocab = 64, .compressed_vocab = 64 };
+fn syntheticImage(g: *G, a: std.mem.Allocator) !Image {
+    const layers = try a.alloc(M.Cache, 1);
+    layers[0] = M.Cache.init(.{ .ratio = 2, .kv_source = true }, 4, .{ .route = .bounded, .max_kv = 16 });
+    errdefer {
+        layers[0].deinit(g);
+        a.free(layers);
+    }
+    const s = &layers[0];
+    s.offset = 4;
+    s.window = .{ .ring = try syntheticRing(g, 4, 4, 4, .bfloat16) };
+    s.compress = .{ .grow = .{ .buf = try syntheticArray(g, 16, 4, .bfloat16, 3), .len = 2, .cap = 16, .init_cap = 16, .bounded_cap = 16 } };
+    s.index = .{ .grow = .{ .buf = try syntheticArray(g, 16, 2, .float32, 5), .len = 2, .cap = 16, .init_cap = 16, .bounded_cap = 16 } };
+    s.frontier = blk: {
+        var fk = try syntheticRing(g, 4, 2, 4, .float32);
+        errdefer fk.deinit(g);
+        const fs = try syntheticRing(g, 4, 2, 4, .float32);
+        break :blk .{ .kv = .{ .ring = fk }, .score = .{ .ring = fs } };
+    };
+    const bs = try a.alloc(M.Cache.Boundary, 1);
+    errdefer a.free(bs);
+    bs[0] = try s.boundary(g);
+    errdefer bs[0].deinit(g);
+    s.offset = 6;
+    s.window.ring.len = 6;
+    s.compress.grow.len = 3;
+    s.index.grow.len = 3;
+    s.frontier.?.kv.ring.len = 6;
+    s.frontier.?.score.ring.len = 6;
+    var st: M.State = .{ .offset = 6, .layers = layers, .hash = .{}, .max_len = 16, .scratch = try a.alloc(u8, 32) };
+    @memset(st.scratch, 99);
+    errdefer {
+        a.free(st.scratch);
+        st.hash.?.deinit(a);
+    }
+    try st.hash.?.hist.appendSlice(a, &.{ 1, 2, -1, -1, 5, 6 });
+    const ids = try a.dupe(u32, &.{ 1, 2, 3, 4 });
+    errdefer a.free(ids);
+    const cs = try a.alloc(H.Cache, 1);
+    errdefer a.free(cs);
+    cs[0] = .{ .offset = 4, .window = try syntheticArray(g, 4, 4, .bfloat16, 7) };
+    errdefer cs[0].deinit(g);
+    const main = try syntheticArray(g, 1, 8, .bfloat16, 11);
+    errdefer g.release(main);
+    var ll: ledger.Ledger = .{};
+    errdefer ll.deinit(a);
+    ll.reset(a, &.{ 1, 2, 3, 4, 5, 6 }, 6);
+    return .{ .state = st, .boundary = .{ .ids = ids, .state = .{ .offset = 4, .layers = bs, .hash_len = 4 }, .caches = cs, .main_h = main, .vision = .{ .key = @splat(3), .offset = 2, .rows = 2, .width = 8 }, .seeded = true }, .committed = ll };
+}
+fn compareImages(a: std.mem.Allocator, g: *G, x: *const Image, y: *const Image, id: Identity) !void {
+    var arena = std.heap.ArenaAllocator.init(a);
+    defer arena.deinit();
+    var left: Export = .{ .a = arena.allocator() };
+    var right: Export = .{ .a = arena.allocator() };
+    const lm = try left.capture(x, id);
+    const rm = try right.capture(y, id);
+    try std.testing.expectEqual(lm.offset, rm.offset);
+    try std.testing.expectEqualSlices(i64, lm.hash.?, rm.hash.?);
+    try std.testing.expectEqualSlices(u32, lm.ledger_ids, rm.ledger_ids);
+    try std.testing.expectEqual(lm.hash_capacity, rm.hash_capacity);
+    try std.testing.expectEqual(lm.ledger_capacity, rm.ledger_capacity);
+    try std.testing.expect(std.meta.eql(lm.vision, rm.vision));
+    try std.testing.expectEqual(left.arrays.items.len, right.arrays.items.len);
+    for (left.arrays.items, right.arrays.items) |u, v| {
+        try mlx.check(mlx.mlx_array_eval(u));
+        try mlx.check(mlx.mlx_array_eval(v));
+        try std.testing.expectEqual(mlx.mlx_array_dtype(u), mlx.mlx_array_dtype(v));
+        try std.testing.expectEqualSlices(c_int, mlx.getShape(u), mlx.getShape(v));
+        try std.testing.expectEqualSlices(u8, try g.hostBytes(u), try g.hostBytes(v));
+    }
+    // Scratch is per-forward FixedBufferAllocator memory; it is recreated zeroed, never persisted as stale pointers.
+    for (y.state.scratch) |b| try std.testing.expectEqual(@as(u8, 0), b);
+}
+fn rewriteManifest(io: std.Io, dir: std.Io.Dir, bytes: []const u8) !void {
+    try dir.writeFile(io, .{ .sub_path = "manifest.json", .data = bytes });
+    var digest: [32]u8 = undefined;
+    SHA.hash(bytes, &digest, .{});
+    try dir.writeFile(io, .{ .sub_path = "manifest.sha256", .data = &digest });
+}
+
+test "S05 SSD codec: complete bounded state real CPU safetensors roundtrip and corrupt records fail closed" {
+    const a = std.testing.allocator;
+    const io = std.testing.io;
+    const cpu = mlx.mlx_default_cpu_stream_new();
+    defer _ = mlx.mlx_stream_free(cpu);
+    var g = try G.init(a, cpu);
+    defer g.deinit();
+    var tmp = std.testing.tmpDir(.{});
+    defer tmp.cleanup();
+    var rb: [1024]u8 = undefined;
+    const project = rb[0..try tmp.dir.realPath(io, &rb)];
+    const id: Identity = .{ .model_revision = @splat('a'), .engine = @splat(1), .geometry = @splat(2), .sampler = @splat(3) };
+    var root = try Root.open(a, io, project, id);
+    defer root.deinit();
+    const key: [32]u8 = @splat(9);
+    var original = try syntheticImage(&g, a);
+    defer original.deinit(&g, a);
+    try root.save(key, &original, test_layout);
+    var loaded = try root.load(&g, key, test_layout);
+    defer loaded.deinit(&g, a);
+    try compareImages(a, &g, &original, &loaded, id);
+    try std.testing.expectError(error.EntryExists, root.save(key, &original, test_layout));
+    const dirname = hex(key);
+    var dir = try root.dir.openDir(io, &dirname, .{});
+    defer dir.close(io);
+    const manifest = try dir.readFileAlloc(io, "manifest.json", a, .limited(metadata_limit));
+    defer a.free(manifest);
+    const payload = try dir.readFileAlloc(io, "state.safetensors", a, .limited(record_limit));
+    defer a.free(payload);
+    root.identity.model_revision[0] = 'b';
+    try std.testing.expectError(error.IdentityMismatch, root.load(&g, key, test_layout));
+    root.identity = id;
+    var wrong = try a.dupe(u8, payload);
+    defer a.free(wrong);
+    wrong[wrong.len - 1] ^= 1;
+    try dir.writeFile(io, .{ .sub_path = "state.safetensors", .data = wrong });
+    try std.testing.expectError(error.BadChecksum, root.load(&g, key, test_layout));
+    try dir.writeFile(io, .{ .sub_path = "state.safetensors", .data = payload[0 .. payload.len - 1] });
+    try std.testing.expectError(error.ShortRead, root.load(&g, key, test_layout));
+    try dir.writeFile(io, .{ .sub_path = "state.safetensors", .data = payload });
+    const p = try std.json.parseFromSlice(Manifest, a, manifest, .{});
+    defer p.deinit();
+    var bad = p.value;
+    bad.arrays[0].shape[2] += 1;
+    var out = try std.json.Stringify.valueAlloc(a, bad, .{});
+    try rewriteManifest(io, dir, out);
+    a.free(out);
+    try std.testing.expectError(error.TensorShape, root.load(&g, key, test_layout));
+    bad.arrays[0].shape[2] -= 1;
+    bad.arrays[0].dtype = .F32;
+    out = try std.json.Stringify.valueAlloc(a, bad, .{});
+    try rewriteManifest(io, dir, out);
+    a.free(out);
+    try std.testing.expectError(error.TensorDtype, root.load(&g, key, test_layout));
+    try rewriteManifest(io, dir, manifest);
+    var after = try root.load(&g, key, test_layout);
+    defer after.deinit(&g, a);
+    try compareImages(a, &g, &original, &after, id);
+    // Imported arrays are distinct allocations, not aliases of the active source session.
+    const src = original.state.layers[0].compress.grow.buf.?;
+    const dst = after.state.layers[0].compress.grow.buf.?;
+    const before = (try g.hostBytes(src))[0];
+    (try g.hostBytes(dst))[0] ^= 1;
+    try std.testing.expectEqual(before, (try g.hostBytes(src))[0]);
+}
