+//! Isolated early-ready scheduling candidate. It changes neither routing nor arithmetic precision.
+const std = @import("std");
+const sdk = @import("sdk");
+pub const max_rows: u32 = 256;
+pub const metadata_reserve_bytes: u64 = 512 << 10;
+pub fn enabled() bool {
+    if (comptime !sdk.plugin_profile) return false;
+    const raw = std.c.getenv("DSV41_EXPERIMENT_EARLY_READY") orelse return false;
+    return std.mem.eql(u8, std.mem.span(raw), "1");
+}
+pub fn eligible(on: bool, rows: u32, hf: bool, rolling: bool, seed: bool, deferred: bool, base_at_seed: bool, aligned: bool, cold: u32) bool {
+    return on and rows > 8 and rows <= max_rows and hf and rolling and seed and deferred and base_at_seed and aligned and cold == 0;
+}
+test "dsv41 early ready: bounded explicit scope" {
+    try std.testing.expect(eligible(true, 38, true, true, true, true, true, true, 0));
+    for ([_]u32{ 1, 8, 257, 16384 }) |n| try std.testing.expect(!eligible(true, n, true, true, true, true, true, true, 0));
+    try std.testing.expect(!eligible(false, 38, true, true, true, true, true, true, 0));
+    try std.testing.expect(!eligible(true, 38, true, false, true, true, true, true, 0));
+    try std.testing.expect(!eligible(true, 38, true, true, true, true, true, true, 1));
+}
