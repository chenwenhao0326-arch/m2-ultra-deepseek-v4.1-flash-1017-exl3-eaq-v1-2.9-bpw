+const ReadyPolicySnapshot = struct { clock: u64, recency: [32]u64, frequency: [32]u32, slots: [32]u32, routes: u64, hits: u64, misses: u64 };
+fn readyPolicyCase(lease_on: bool) !ReadyPolicySnapshot {
+    var sb = try SynthBank.open(32);
+    defer sb.close();
