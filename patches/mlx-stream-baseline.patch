+    defer entries.deinit(a);
+    if (prior) |p| for (p.value.entries) |e| if (!std.mem.eql(u8, e.key_sha, entry.key_sha)) {
+        try entries.append(a, e);
+    };
+    try entries.append(a, entry);
+    var sum: u64 = 0;
+    for (entries.items) |e| sum += e.bytes;
+    while (entries.items.len > max_entries or sum > quota_bytes) {
+        sum -= entries.items[0].bytes;
+        _ = entries.orderedRemove(0);
+    }
+    const content = try std.json.Stringify.valueAlloc(a, Index{ .schema = schema, .entries = entries.items }, .{});
+    defer a.free(content);
+    const tmp = try std.fmt.allocPrint(a, "{s}/index.tmp-{d}", .{ opt.directory, std.c.getpid() });
+    defer a.free(tmp);
+    const target = try std.fmt.allocPrint(a, "{s}/index.json", .{opt.directory});
+    defer a.free(target);
+    try cwd().writeFile(io, .{ .sub_path = tmp, .data = content });
+    errdefer cwd().deleteFile(io, tmp) catch {};
