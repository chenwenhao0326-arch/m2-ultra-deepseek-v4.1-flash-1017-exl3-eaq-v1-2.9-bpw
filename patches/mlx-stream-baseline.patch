+    // Only the metadata consumed by newStateWith/scratchBytes; no model weights or table reads.
+    var src: @import("engram.zig").RowSource = undefined;
+    src.hashing = .{ .max_ngram = 1, .n_heads = 1, .n_layers = 0, .pad_id = 0, .compressed_vocab = 64 };
+    src.bank.head_dim = 32;
