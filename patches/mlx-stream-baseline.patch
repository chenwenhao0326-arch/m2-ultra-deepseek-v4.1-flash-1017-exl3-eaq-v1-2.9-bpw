+pub const LayerContract = struct { ratio: u8, kv_source: bool };
+pub const Layout = struct { layers: []const LayerContract, window: u32, head_dim: u32, index_dim: u32, main_dim: u32, stages: u32, max_kv: u32, scratch_bytes: usize, has_engram: bool, vocab: u32, compressed_vocab: u32 };
+pub const Boundary = struct {
+    ids: []u32,
+    state: M.Boundary,
+    caches: []H.Cache = &.{},
+    main_h: ?G.T = null,
+    vision: ?Vision = null,
+    seeded: bool = false,
+    pub fn deinit(b: *Boundary, g: *G, a: std.mem.Allocator) void {
+        b.state.deinit(g, a);
+        for (b.caches) |*c| c.deinit(g);
+        a.free(b.caches);
+        if (b.main_h) |x| g.release(x);
+        a.free(b.ids);
+    }
+};
+pub const Image = struct {
+    state: M.State,
+    boundary: Boundary,
+    committed: ledger.Ledger,
+    pub fn deinit(v: *Image, g: *G, a: std.mem.Allocator) void {
+        v.boundary.deinit(g, a);
+        v.state.deinit(g, a);
+        v.committed.deinit(a);
+    }
+};
+const Dtype = enum { BF16, F32 };
+const Ref = ?u32;
+const Array = struct { shape: [3]u32, dtype: Dtype, bytes: u64 };
+const Ring = struct { window: u32, cap_keep: u32, phys_cap: u32, base_phys_cap: u32, bufs: [2]Ref, caps: [2]u32, cur: u1, len: u32, drop: u32 };
+const Grow = struct { buf: Ref, len: u32, cap: u32, init_cap: u32, bounded_cap: u32 };
+const Frontier = struct { kv: Ring, score: Ring };
+const Layer = struct { offset: u32, window_size: u32, ratio: u32, kv_source: bool, bounded_max_kv: u32, window: Ring, compress: Grow, index: Grow, frontier: ?Frontier };
+const LayerBoundary = struct { offset: u32, window: Ring, compress: u32, index: u32, frontier: ?Frontier };
+const Draft = struct { window: Ref, offset: u32 };
+const Manifest = struct {
+    identity: Identity,
+    payload_bytes: u64 = 0,
+    payload_sha256: [32]u8 = @splat(0),
+    arrays: []Array,
+    offset: u32,
+    max_len: u32,
+    scratch_bytes: usize,
+    layers: []Layer,
+    hash: ?[]i64,
+    hash_capacity: usize,
+    boundary_offset: u32,
+    boundary_layers: []LayerBoundary,
+    boundary_hash_len: usize,
+    ids: []u32,
+    draft: []Draft,
