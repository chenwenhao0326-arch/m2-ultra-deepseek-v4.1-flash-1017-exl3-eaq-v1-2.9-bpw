+        };
+    }
+    fn capture(e: *Export, v: *const Image, id: Identity) !Manifest {
+        if (v.state.span_chunk != null) return error.IncompleteState;
+        const ls = try e.a.alloc(Layer, v.state.layers.len);
+        for (v.state.layers, ls) |s, *o| o.* = .{ .offset = s.offset, .window_size = s.window_size, .ratio = s.ratio, .kv_source = s.kv_source, .bounded_max_kv = s.bounded_max_kv orelse return error.UnboundedState, .window = try e.window(s.window), .compress = try e.grow(s.compress), .index = try e.grow(s.index), .frontier = if (s.frontier) |f| .{ .kv = try e.window(f.kv), .score = try e.window(f.score) } else null };
