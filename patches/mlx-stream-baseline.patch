+fn readIndex(a: std.mem.Allocator, io: std.Io, opt: Options) !?std.json.Parsed(Index) {
+    const path = try std.fmt.allocPrint(a, "{s}/index.json", .{opt.directory});
+    defer a.free(path);
+    const data = cwd().readFileAlloc(io, path, a, .limited(1 << 20)) catch |err| switch (err) {
+        error.FileNotFound => return null,
+        else => return err,
+    };
+    defer a.free(data);
+    var result = try std.json.parseFromSlice(Index, a, data, .{ .allocate = .alloc_always });
+    errdefer result.deinit();
+    if (result.value.schema != schema or result.value.entries.len > max_entries) return error.BadSnapshotIndex;
+    for (result.value.entries) |e| if (!validDigest(e.file_sha) or !validDigest(e.key_sha) or e.bytes > max_file_bytes or e.tokens == 0) return error.BadSnapshotIndex;
+    return result;
