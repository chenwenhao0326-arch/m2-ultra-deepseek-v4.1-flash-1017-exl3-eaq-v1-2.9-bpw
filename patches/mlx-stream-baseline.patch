+    while (positions <= c.max_context_tokens.?) : (positions += 1) {
+        rows = 1;
+        while (rows <= @min(positions, pe.max_prompt_tokens)) : (rows += 1) {
+            const wave = bill.turnCallWave(pb, lm, joined, rows, positions);
+            if (wave > maximum) { maximum = wave; witness = .{ .rows = rows, .positions = positions }; }
+            queries += 1;
+        }
+    }
+    for ([_]u32{ 184, 272 }) |decode| {
+        c.expert_rows = decode;
+        const full = try bill.servedBill(a, testing.io, &c, 0, 188 << 30, .{});
+        const actual_pb = try bill.servedPrefillBill(&c, .{}, &mc, full.variant);
+        try testing.expectEqualDeep(pb, actual_pb); // Cache rows change storage, not the query wave.
+        const logical = @as(u64, decode - 128) * full.persistentRowBytes();
+        const rounded = logical + @as(u64, full.layers) * bank.n_components * module.grow_alloc_round_bytes;
+        var largest = try bill.parkedQueryBill(full, pb, lm, joined, logical, rounded, witness);
