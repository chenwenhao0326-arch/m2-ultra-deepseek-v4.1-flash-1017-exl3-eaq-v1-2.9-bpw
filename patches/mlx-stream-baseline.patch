+            return out;
+        }
+    };
+}
+
+test "compact GU: strict profile C02 opt-in and only measured assignment widths" {
+    const t = std.testing;
+    try t.expect(enabledValue(true, "1", "1"));
+    try t.expect(!enabledValue(false, "1", "1"));
+    try t.expect(!enabledValue(true, null, "1"));
+    try t.expect(!enabledValue(true, "1", "0"));
+    try t.expect(!enabledValue(true, "true", "1"));
+    for (0..49) |n| try t.expectEqual(n == 18 or n == 24 or n == 30, slot(n) != null);
+}
