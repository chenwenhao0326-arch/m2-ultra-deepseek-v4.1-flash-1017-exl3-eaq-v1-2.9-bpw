+    var opt: Options = .{ .directory = try std.fmt.allocPrint(a, "{s}/state", .{directory}), .identity = try a.dupe(u8, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") };
+    defer opt.deinit(a);
+    const cfg = @import("deepseek_v41.zig");
