diff --git a/src/arch/deepseek_v41/prefill_suffix.zig b/src/arch/deepseek_v41/prefill_suffix.zig
new file mode 100644
index 0000000..b7f7428
--- /dev/null
+++ b/src/arch/deepseek_v41/prefill_suffix.zig
@@ -0,0 +1,78 @@
+//! Exact observable-tail dependency bound, NOT a fixed 128/140-row replay.
+//! Last global KV producer and every earlier layer remain full length. Each later
+//! layer has only pointwise/global-read and causal SWA dependencies. A missing
+//! left edge can propagate at most window-1 positions per layer. Retain that
+//! entire cone plus every persistent ring's retained/rollback rows. Discard all
+//! potentially affected rows before publishing state. Only an explicit caller
+//! that consumes final logits and the last draft window may use this plan.
+const std = @import("std");
+const v41 = @import("deepseek_v41.zig");
+
+pub const Plan = struct {
+    start_layer: usize,
+    first_span: usize,
+    skip_rows: u32,
+    dependency_rows: u32,
+    retained_rows: u32,
+};
+
+pub fn make(c: *const v41.Config, layers: anytype, spans: []const [2]u32) ?Plan {
+    if (spans.len < 2 or c.window == 0 or layers.len != c.n_layers) return null;
+    var last_source: ?usize = null;
+    for (c.layers[0..c.n_layers], 0..) |li, l| if (li.kv_source) { last_source = l; };
+    const start = (last_source orelse return null) + 1;
+    if (start >= c.n_layers) return null;
+    // A stored DSpark tap before the cut cannot be shape-shortened with the rest.
+    for (c.layers[0..start]) |li| if (li.dspark_target) return null;
+    var retained: u32 = c.window;
+    for (c.layers[start..c.n_layers], layers[start..]) |li, lc| {
+        if (li.kv_source or li.engram_slot != null or lc.frontier != null or lc.window != .ring) return null;
+        if (lc.window_size != c.window or lc.window.ring.window != c.window) return null;
+        retained = @max(retained, lc.window.ring.cap_keep);
+    }
+    const dependency = std.math.mul(u32, @intCast(c.n_layers - start), c.window - 1) catch return null;
+    const need = std.math.add(u32, dependency, retained) catch return null;
+    const n = spans[spans.len - 1][1];
+    if (n <= need) return null;
+    var first: usize = 0;
+    for (spans, 0..) |sp, i| {
+        if (n - sp[0] >= need) first = i else break;
+    }
+    if (first == 0) return null;
+    return .{ .start_layer = start, .first_span = first, .skip_rows = spans[first][0], .dependency_rows = dependency, .retained_rows = retained };
+}
+
+test "prefill suffix: finite causal cone preserves every retained row, not just last logits" {
+    // Independent integer recurrence: full global reads, pointwise nonlinearities,
+    // and every local dependency. Truncated prefix is deliberately adversarial.
+    const n = 257;
+    const window = 7;
+    const layers = 6;
+    const keep = 18;
+    const need = layers * (window - 1) + keep;
+    const begin = n - need;
+    var full: [n]u64 = undefined;
+    var cut: [n]u64 = undefined;
+    for (&full, &cut, 0..) |*f, *x, i| { f.* = i * i + 7919; x.* = f.*; }
+    for (0..layers) |l| {
+        // KV inputs of all retained rows are identical at EVERY layer, enabling
+        // future decoding, rollback and persistence, not only the final answer.
+        try std.testing.expectEqualSlices(u64, full[n - keep ..], cut[n - keep ..]);
+        const old = full;
+        const clipped = cut;
+        for (0..n) |i| {
+            var v: u64 = 20261017 + l; // independent full global KV read
+            var w = v;
+            const lo = i - @min(i, window - 1);
+            for (lo..i + 1) |j| {
+                v = v *% 17 +% old[j];
+                w = w *% 17 +% (if (j >= begin) clipped[j] else 0xfedcba9876543210);
+            }
+            full[i] = v ^ (old[i] *% 31);
+            cut[i] = w ^ (clipped[i] *% 31);
+        }
+        try std.testing.expectEqualSlices(u64, full[n - keep ..], cut[n - keep ..]);
+    }
+    // The prefix really differs: this test is not comparing identical truncations.
+    try std.testing.expect(full[begin] != cut[begin]);
+}
