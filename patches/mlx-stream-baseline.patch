diff --git a/src/arch/deepseek_v41/c04b_gather.zig b/src/arch/deepseek_v41/c04b_gather.zig
new file mode 100644
index 0000000..41a6186
--- /dev/null
+++ b/src/arch/deepseek_v41/c04b_gather.zig
@@ -0,0 +1,100 @@
+//! Isolated C04b prototype. Only movement/casting; native GEMMs and softmax stay outside.
+//! Caller supplies legal selected indexes as the existing eager gather path does.
+const std = @import("std");
+const mlx = @import("sdk").mlx;
+const sdk = @import("sdk");
+const ops = @import("ops.zig");
+const mtl = @import("../../sdk_ext/metal_launch.zig");
+const DT = ops.Dtype;
+
+pub fn enabledValue(profile: bool, value: ?[]const u8) bool {
+    return profile and value != null and std.mem.eql(u8, value.?, "1");
+}
+pub fn enabled() bool {
+    const value = if (std.c.getenv("DSV41_EXPERIMENT_FUSED_KV_GATHER")) |v| std.mem.span(v) else null;
+    return enabledValue(sdk.plugin_profile, value);
+}
+
+pub fn Gather(comptime G: type) type {
+    return struct {
+        const T = G.T;
+        kernel: mlx.mlx_fast_metal_kernel,
+        plans: [8]?Plan = @splat(null),
+        const Plan = struct { kc: c_int, config: mlx.mlx_fast_metal_kernel_config };
+        pub fn init() !@This() {
+            if (comptime G != ops.MlxOps) return .{ .kernel = .{} };
+            const iv = mlx.mlx_vector_string_new_data(&.{ "win", "widx", "wval", "ckv", "cidx" }, 5);
+            defer _ = mlx.mlx_vector_string_free(iv);
+            const ov = mlx.mlx_vector_string_new_data(&.{ "rows", "valid" }, 2);
+            defer _ = mlx.mlx_vector_string_free(ov);
+            const kernel = mtl.mlx_fast_metal_kernel_new("c04b_selected_kv_gather", iv, ov, @embedFile("c04b_kv_gather.metal"), "", false, false);
+            if (kernel.ctx == null) return error.MlxError;
+            return .{ .kernel = kernel };
+        }
+        pub fn deinit(self: *@This()) void {
+            if (comptime G != ops.MlxOps) return;
+            for (self.plans) |p| {
+                if (p) |plan| {
+                    _ = mlx.mlx_fast_metal_kernel_config_free(plan.config);
+                }
+            }
+            mtl.mlx_fast_metal_kernel_free(self.kernel);
+            self.* = undefined;
+        }
+        fn floatType(dt: DT) bool {
+            return dt == .bfloat16 or dt == .float32;
+        }
+        pub fn run(self: *@This(), g: *G, win: T, widx: T, wval: T, compressed: ?[2]T) !?[2]T {
+            const ws = g.shapeOf(win);
+            const is = g.shapeOf(widx);
+            const vs = g.shapeOf(wval);
+            if (ws.n != 3 or ws.d[0] != 1 or ws.d[1] < 1 or ws.d[2] != 512 or !floatType(g.dtypeOf(win))) return null;
+            if (is.n != 3 or is.d[0] != 1 or is.d[1] < 1 or is.d[1] > 8 or is.d[2] != 128 or !is.eql(vs) or g.dtypeOf(widx) != .int32 or g.dtypeOf(wval) != .bool_) return null;
+            var kc: c_int = 0;
+            if (compressed) |c| {
+                const cs = g.shapeOf(c[0]);
+                const ci = g.shapeOf(c[1]);
+                if (cs.n != 3 or cs.d[0] != 1 or cs.d[1] < 1 or cs.d[2] != 512 or !floatType(g.dtypeOf(c[0]))) return null;
+                if (ci.n != 3 or ci.d[0] != 1 or ci.d[1] != is.d[1] or ci.d[2] < 1 or ci.d[2] > 512 or g.dtypeOf(c[1]) != .int32) return null;
+                kc = ci.d[2];
+            }
+            if (comptime G != ops.MlxOps) return .{
+                try g.kernel(&.{ 1, is.d[1], 128 + kc, 512 }, .float32),
+                try g.kernel(&.{ 1, is.d[1], 128 + kc }, .bool_),
+            };
+            const p = &self.plans[@intCast(is.d[1] - 1)];
+            if (p.* != null and p.*.?.kc != kc) {
+                _ = mlx.mlx_fast_metal_kernel_config_free(p.*.?.config);
+                p.* = null;
+            }
+            if (p.* == null) {
+                const c = mlx.mlx_fast_metal_kernel_config_new();
+                errdefer _ = mlx.mlx_fast_metal_kernel_config_free(c);
+                try mlx.check(mlx.mlx_fast_metal_kernel_config_add_output_arg(c, &.{ 1, is.d[1], 128 + kc, 512 }, 4, .float32));
+                try mlx.check(mlx.mlx_fast_metal_kernel_config_add_output_arg(c, &.{ 1, is.d[1], 128 + kc }, 3, .bool_));
+                try mlx.check(mlx.mlx_fast_metal_kernel_config_set_grid(c, is.d[1] * (128 + kc) * 128, 1, 1));
+                try mlx.check(mlx.mlx_fast_metal_kernel_config_set_thread_group(c, 256, 1, 1));
+                try mlx.check(mlx.mlx_fast_metal_kernel_config_add_template_arg_bool(c, "HAS_COMP", compressed != null));
+                p.* = .{ .kc = kc, .config = c };
+            }
+            const extra = compressed orelse [2]T{ win, widx };
+            const vin = mlx.mlx_vector_array_new_data(&.{ win, widx, wval, extra[0], extra[1] }, 5);
+            defer _ = mlx.mlx_vector_array_free(vin);
+            var vout = mlx.mlx_vector_array_new();
+            defer _ = mlx.mlx_vector_array_free(vout);
+            try mlx.check(mtl.mlx_fast_metal_kernel_apply(&vout, self.kernel, vin, p.*.?.config, g.s));
+            const mark = g.mark();
+            errdefer g.resetTo(mark);
+            var out: [2]T = undefined;
+            for (&out, 0..) |*v, i| {
+                var arr = mlx.mlx_array_new();
+                mlx.check(mlx.mlx_vector_array_get(&arr, vout, i)) catch |err| {
+                    _ = mlx.mlx_array_free(arr);
+                    return err;
+                };
+                v.* = try g.adopt(arr);
+            }
+            return out;
+        }
+    };
+}
diff --git a/src/arch/deepseek_v41/c04b_kv_gather.metal b/src/arch/deepseek_v41/c04b_kv_gather.metal
new file mode 100644
index 0000000..ed5cd54
--- /dev/null
+++ b/src/arch/deepseek_v41/c04b_kv_gather.metal
@@ -0,0 +1,24 @@
+// C04b: order-preserving selected-row copy, modeled on Sushi's four-values/thread gather.
+// Deliberately retains invalid-row-0 contents, matching DeepSeek gatherRows (not zero fill).
+const uint i = thread_position_in_grid.x;
+const uint K = 128u + (HAS_COMP ? uint(cidx_shape[2]) : 0u);
+const uint total = uint(widx_shape[1]) * K * 128u;
+if (i >= total) return;
+const uint slot = i / 128u;
+const uint d = (i % 128u) * 4u;
+const uint s = slot / K;
+const uint key = slot % K;
+if (key < 128u) {
+    const bool ok = wval[int64_t(s) * wval_strides[1] + int64_t(key) * wval_strides[2]];
+    const int r = ok ? int(widx[int64_t(s) * widx_strides[1] + int64_t(key) * widx_strides[2]]) : 0;
+    if (d == 0u) valid[slot] = ok;
+    for (uint j = 0u; j < 4u; ++j)
+        rows[int64_t(slot) * 512 + d + j] = float(win[int64_t(r) * win_strides[1] + int64_t(d + j) * win_strides[2]]);
+} else {
+    const int selected = int(cidx[int64_t(s) * cidx_strides[1] + int64_t(key - 128u) * cidx_strides[2]]);
+    const bool ok = selected >= 0;
+    const int r = ok ? selected : 0;
+    if (d == 0u) valid[slot] = ok;
+    for (uint j = 0u; j < 4u; ++j)
+        rows[int64_t(slot) * 512 + d + j] = float(ckv[int64_t(r) * ckv_strides[1] + int64_t(d + j) * ckv_strides[2]]);
+}
diff --git a/src/arch/deepseek_v41/causality_capture.zig b/src/arch/deepseek_v41/causality_capture.zig
new file mode 100644
index 0000000..a9a4b20
--- /dev/null
+++ b/src/arch/deepseek_v41/causality_capture.zig
@@ -0,0 +1,417 @@
+//! Isolated HTTP causality observer. No extra graph evaluations or GPU synchronizations.
+const std = @import("std");
+const sdk = @import("sdk");
+const dt = @import("decode_timers.zig");
+const tl = @import("verify_timeline.zig");
+const ds = @import("dspark.zig");
+const io_trace = @import("io_causality.zig");
+pub const max_rounds = 512;
+const max_layers = 64;
+const max_experts = 512;
+const max_ids = 48;
+pub var selected = false;
+pub var observing = false;
+pub var active = false;
+var exported = false;
+var path: ?[]const u8 = null;
+var capture_error: ?[]const u8 = null;
+var overflow = false;
+var n_rounds: usize = 0;
+var in_round = false;
+var meta: Metadata = .{};
+var rounds: [max_rounds]Round = undefined;
+var layer_rows: [max_rounds][max_layers]Layer = undefined;
+var lut: [max_layers][2][max_experts]u32 = undefined;
+var lut_len: [max_layers][2]usize = @splat(@splat(0));
+var stats_end: ?ds.Stats = null;
+var dt0: @TypeOf(dt.ns) = undefined;
+const max_prefill_id_calls = 4096;
+const PrefillIds = struct { layer: u32, at_ns: u64, n_ids: u32, expert_bits: [8]u64, early_experts: u32 = 0, early_rows: u32 = 0, early_begin_ns: ?u64 = null, early_end_ns: ?u64 = null };
+var prefill_id_rows: [max_prefill_id_calls]PrefillIds = undefined;
+var n_prefill_id_rows: usize = 0;
+var prefill_id_overflow = false;
+
+/// Called after the existing hostIds, never evaluates/synchronizes a tensor.
+pub fn prefillIds(layer: u32, ids: []const u16) void {
+    if (comptime !sdk.plugin_profile) return;
+    if (!selected or exported or !observing) return;
+    if (n_prefill_id_rows == max_prefill_id_calls) {
+        prefill_id_overflow = true;
+        return;
+    }
+    var row: PrefillIds = .{ .layer = layer, .at_ns = tl.now(), .n_ids = @intCast(ids.len), .expert_bits = @splat(0) };
+    for (ids) |id| {
+        if (id >= 512) {
+            prefill_id_overflow = true;
+            return;
+        }
+        row.expert_bits[id / 64] |= @as(u64, 1) << @intCast(id % 64);
+    }
+    prefill_id_rows[n_prefill_id_rows] = row;
+    n_prefill_id_rows += 1;
+}
+
+pub fn earlyReady(layer: u32, experts: u32, rows_: u32, begin: u64, end: u64) void {
+    if (comptime !sdk.plugin_profile) return;
+    if (!selected or exported or !observing or n_prefill_id_rows == 0) return;
+    const r = &prefill_id_rows[n_prefill_id_rows - 1];
+    if (r.layer != layer) {
+        prefill_id_overflow = true;
+        return;
+    }
+    r.early_experts = experts;
+    r.early_rows = rows_;
+    r.early_begin_ns = begin;
+    r.early_end_ns = end;
+}
+
+pub const Metadata = struct {
+    request: u64 = 0,
+    prompt_tokens: u64 = 0,
+    context_tokens: u64 = 0,
+    max_tokens: u32 = 0,
+    observer: bool = false,
+    c01: ?bool = null,
+    s03: ?bool = null,
+    native_draft: ?bool = null,
+    prefill_begin_ns: ?u64 = null,
+    prefill_model_return_ns: ?u64 = null,
+    prefill_end_ns: ?u64 = null,
+    prefill_cb_end: ?u32 = null,
+    handover_cb_end: ?u32 = null,
+    decode_begin_ns: ?u64 = null,
+    last_round_end_ns: ?u64 = null,
+    temperature: ?f32 = null,
+    top_p: ?f32 = null,
+    top_k: ?u32 = null,
+    min_p: ?f32 = null,
+    seed: ?u64 = null,
+};
+pub const Round = struct {
+    round: usize = 0,
+    position: u64 = 0,
+    accepted_cap: u32 = 0,
+    k_eff: ?u32 = null,
+    n_block: ?u32 = null,
+    accepted_before_cap: ?u32 = null,
+    kept: ?u32 = null,
+    ahead_consumed: ?bool = null,
+    ahead_built: ?bool = null,
+    ahead_taken: ?bool = null,
+    whole_verify: ?bool = null,
+    discard_reason: ?[]const u8 = null,
+    begin_ns: ?u64 = null,
+    end_ns: ?u64 = null,
+    submit_begin_ns: ?u64 = null,
+    submit_end_ns: ?u64 = null,
+    prebuild_begin_ns: ?u64 = null,
+    prebuild_end_ns: ?u64 = null,
+    wait_begin_ns: ?u64 = null,
+    wait_end_ns: ?u64 = null,
+    dt_ns: ?@TypeOf(dt.ns) = null,
+    returned: u32 = 0,
+    tokens: [8]u32 = @splat(0),
+    next_token: ?u32 = null,
+};
+pub const Layer = struct {
+    observed: bool = false,
+    n_ids: u32 = 0,
+    n_rows: u32 = 0,
+    top_k: u32 = 0,
+    ids: [max_ids]u16 = @splat(0),
+    packed_lut: [max_ids]u32 = @splat(0),
+    missing_assignments: ?u32 = null,
+    distinct_missing: ?u32 = null,
+    genuine_base0: ?u32 = null,
+    legacy_base0_pairs: ?u32 = null,
+    parity: ?u1 = null,
+    dev_submit_begin_ns: ?u64 = null,
+    dev_submit_end_ns: ?u64 = null,
+    dev_cb_before: ?u32 = null,
+    dev_cb_after: ?u32 = null,
+};
+
+fn envIs(name: [*:0]const u8, value: []const u8) bool {
+    const raw = std.c.getenv(name) orelse return false;
+    return std.mem.eql(u8, std.mem.span(raw), value);
+}
+
+pub fn prepare(request: u64, prompt: u64, context: u64, max_tokens: u32, stream: sdk.mlx.mlx_stream, n_layers: u32) void {
+    if (comptime !sdk.plugin_profile) return;
+    if (selected and !exported) return;
+    const want_s = std.c.getenv("DSV41_CAUSAL_REQUEST") orelse return;
+    const want = std.fmt.parseInt(u64, std.mem.span(want_s), 10) catch return;
+    if (request != want) return;
+    const out = std.c.getenv("DSV41_CAUSAL_OUT") orelse return;
+    path = std.mem.span(out);
+    selected = true;
+    observing = envIs("DSV41_CAUSAL_OBSERVER", "1");
+    exported = false;
+    active = false;
+    in_round = false;
+    n_rounds = 0;
+    n_prefill_id_rows = 0;
+    prefill_id_overflow = false;
+    capture_error = if (std.fs.path.isAbsolute(path.?)) null else "OutputPathNotAbsolute";
+    overflow = false;
+    stats_end = null;
+    lut_len = @splat(@splat(0));
+    meta = .{ .request = request, .prompt_tokens = prompt, .context_tokens = context, .max_tokens = max_tokens, .observer = observing };
+    if (max_tokens > max_rounds) capture_error = "RequestedCaptureExceeds512Tokens";
+    if (observing) {
+        meta.prefill_begin_ns = tl.now();
+        io_trace.begin() catch |err| {
+            capture_error = @errorName(err);
+            return;
+        };
+        tl.install(stream, max_rounds + 1, n_layers) catch |err| {
+            capture_error = @errorName(err);
+            return;
+        };
+        tl.markExternalPhase(.prefill);
+    }
+}
+
+pub fn prefillEnd() void {
+    if (selected and !exported and observing) meta.prefill_model_return_ns = tl.now();
+}
+
+pub fn startHandover() void {
+    if (selected and !exported and observing) {
+        meta.prefill_end_ns = tl.now();
+        meta.prefill_cb_end = tl.counts()[0];
+        tl.markExternalPhase(.handover);
+    }
+}
+
+pub fn startDecode(c01: bool, s03: bool, native: bool) void {
+    if (!selected or exported or active or capture_error != null) return;
+    meta.c01 = c01;
+    meta.s03 = s03;
+    meta.native_draft = native;
+    if (observing) {
+        meta.handover_cb_end = tl.counts()[0];
+        tl.markExternalPhase(.rest);
+        dt.reset();
+        meta.decode_begin_ns = tl.now();
+    }
+    active = true;
+}
+
+pub fn setSampling(s: anytype) void {
+    if (!active) return;
+    meta.temperature = s.temperature;
+    meta.top_p = s.top_p;
+    meta.top_k = s.top_k;
+    meta.min_p = s.min_p;
+    meta.seed = s.seed;
+}
+
+pub fn roundBegin(position: u64, cap: u32) void {
+    if (!active) return;
+    if (n_rounds == max_rounds) {
+        overflow = true;
+        active = false;
+        tl.disarm();
+        return;
+    }
+    in_round = true;
+    rounds[n_rounds] = .{ .round = n_rounds, .position = position, .accepted_cap = cap };
+    if (observing) {
+        rounds[n_rounds].begin_ns = tl.now();
+        layer_rows[n_rounds] = @splat(.{});
+        dt0 = dt.ns;
+    }
+}
+
+pub fn current() ?*Round {
+    return if (active and observing and in_round) &rounds[n_rounds] else null;
+}
+
+pub fn roundEnd(tokens: []const u32, next: u32, stats: ds.Stats) void {
+    if (!active or !in_round) return;
+    const r = &rounds[n_rounds];
+    if (tokens.len > r.tokens.len) {
+        overflow = true;
+    } else {
+        @memcpy(r.tokens[0..tokens.len], tokens);
+        r.returned = @intCast(tokens.len);
+    }
+    r.next_token = next;
+    stats_end = stats;
+    if (observing) {
+        r.end_ns = tl.now();
+        meta.last_round_end_ns = r.end_ns;
+        var delta: @TypeOf(dt.ns) = undefined;
+        for (&delta, dt.ns, dt0) |*d, after, before| d.* = after -| before;
+        r.dt_ns = delta;
+    }
+    in_round = false;
+    n_rounds += 1;
+}
+
+pub fn roundFailed() void {
+    if (!selected or exported or !in_round) return;
+    capture_error = "DecodeRoundFailed";
+    in_round = false;
+}
+
+pub fn shadowWanted() bool {
+    return selected and observing and !exported;
+}
+
+/// Always supplied sentinel-normalized refs, including control arm where GPU uses legacy zero.
+pub fn shadow(layer: u32, parity: u1, refs: []const u32) void {
+    if (!shadowWanted()) return;
+    if (layer >= max_layers or refs.len > max_experts) {
+        overflow = true;
+        return;
+    }
+    @memcpy(lut[layer][parity][0..refs.len], refs);
+    lut_len[layer][parity] = refs.len;
+}
+
+fn layerOf(layer: u32) ?*Layer {
+    if (current() == null or layer >= max_layers) return null;
+    return &layer_rows[n_rounds][layer];
+}
+
+pub fn devSubmit(layer: u32, begin: bool) void {
+    const l = layerOf(layer) orelse return;
+    if (begin) {
+        l.dev_submit_begin_ns = tl.now();
+        l.dev_cb_before = tl.counts()[0];
+    } else {
+        l.dev_submit_end_ns = tl.now();
+        l.dev_cb_after = tl.counts()[0];
+    }
+}
+
+pub fn routeIds(layer: u32, parity: u1, ids: []const u16, n: u32, k: u32) void {
+    const l = layerOf(layer) orelse return;
+    if (ids.len > max_ids) {
+        overflow = true;
+        return;
+    }
+    if (l.observed) capture_error = "MultipleLayerCallsInOneRound";
+    l.observed = true;
+    l.n_ids = @intCast(ids.len);
+    l.n_rows = n;
+    l.top_k = k;
+    l.parity = parity;
+    @memcpy(l.ids[0..ids.len], ids);
+    const ln = lut_len[layer][parity];
+    if (ln == 0) return; // missing observation is null, not fabricated zero
+    var invalid: u32 = 0;
+    var base0: u32 = 0;
+    var unique: std.StaticBitSet(max_experts) = .empty;
+    for (ids, 0..) |id, i| {
+        if (id >= ln) {
+            capture_error = "RouterIdOutsideLut";
+            return;
+        }
+        const ref = lut[layer][parity][id];
+        l.packed_lut[i] = ref;
+        if (ref == std.math.maxInt(u32)) {
+            invalid += 1;
+            unique.set(id);
+        }
+        if (ref == 0) base0 += 1;
+    }
+    l.missing_assignments = invalid;
+    l.distinct_missing = @intCast(unique.count());
+    l.genuine_base0 = base0;
+    l.legacy_base0_pairs = (invalid + base0) / 2;
+}
+
+/// Called by Module at next prefill/deinit, outside the measured response. No GPU sync.
+pub fn finish(a: std.mem.Allocator, io: std.Io) !void {
+    if (!selected or exported) return;
+    active = false;
+    var pending: ?u32 = null;
+    if (observing) {
+        io_trace.end();
+        if (tl.active) pending = tl.settleWithoutSync(2000);
+        tl.uninstall();
+    }
+    exported = true;
+    if (capture_error != null and path == null) return;
+    const io_info = if (observing) io_trace.info() else null;
+    const gpu_dropped: ?u32 = if (observing and pending != null) tl.counts()[2] else null;
+    var output: std.Io.Writer.Allocating = .init(a);
+    defer output.deinit();
+    const w = &output.writer;
+    const data = try std.json.Stringify.valueAlloc(a, .{
+        .schema = "http-optimization-causality-v1",
+        .metadata = meta,
+        .complete = capture_error == null and !overflow and !in_round and (pending == null or pending.? == 0) and (gpu_dropped == null or gpu_dropped.? == 0) and (io_info == null or (io_info.?[4] == 0 and io_info.?[5] == 0)),
+        .capture_error = capture_error,
+        .overflow = overflow,
+        .pending_gpu_callbacks = pending,
+        .dropped_gpu_callbacks = gpu_dropped,
+        .clock = "UPTIME_RAW absolute ns for all host/GPU/I/O stamps; dt arrays are duration deltas",
+        .dt_bucket_names = @typeInfo(dt.Bucket).@"enum".field_names,
+        .rounds = rounds[0..n_rounds],
+        .dspark_stats = stats_end,
+        .layer_observations = if (observing) layer_rows[0..n_rounds] else null,
+        .prefill_id_observations = if (observing) prefill_id_rows[0..n_prefill_id_rows] else null,
+        .prefill_id_overflow = prefill_id_overflow,
+    }, .{});
+    defer a.free(data);
+    try w.writeAll(data[0 .. data.len - 1]);
+    try w.writeAll(",\"gpu\":");
+    if (observing and pending != null and pending.? == 0) try tl.writeAbsoluteJson(w) else try w.writeAll("null");
+    try w.writeAll(",\"io_causality\":");
+    if (observing) try io_trace.writeJson(w) else try w.writeAll("null");
+    try w.writeAll("}\n");
+    const p = path orelse return error.OutputPathMissing;
+    if (!std.fs.path.isAbsolute(p)) return error.OutputPathNotAbsolute;
+    try std.Io.Dir.cwd().writeFile(io, .{ .sub_path = p, .data = output.written(), .flags = .{ .exclusive = true } });
+    sdk.log.info("NATIVE CAUSAL_CAPTURE request={d} rounds={d} observer={} out={s}\n", .{ meta.request, n_rounds, observing, p });
+}
+
+test "causality observer: exact parity distinguishes real base0, missing and repeated ids" {
+    selected = true;
+    observing = true;
+    active = true;
+    exported = false;
+    in_round = true;
+    n_rounds = 0;
+    defer {
+        selected = false;
+        observing = false;
+        active = false;
+        in_round = false;
+    }
+    layer_rows[0] = @splat(.{});
+    shadow(0, 0, &.{ 0, std.math.maxInt(u32), 2, std.math.maxInt(u32) });
+    shadow(0, 1, &.{ std.math.maxInt(u32), 3, 2, 0 });
+    routeIds(0, 0, &.{ 0, 1, 1, 2, 3 }, 1, 5);
+    const l = layer_rows[0][0];
+    try std.testing.expectEqual(@as(?u32, 3), l.missing_assignments);
+    try std.testing.expectEqual(@as(?u32, 2), l.distinct_missing);
+    try std.testing.expectEqual(@as(?u32, 1), l.genuine_base0);
+    try std.testing.expectEqual(@as(?u32, 2), l.legacy_base0_pairs);
+    layer_rows[0][0] = .{};
+    routeIds(0, 1, &.{ 0, 1, 1, 2, 3 }, 1, 5);
+    try std.testing.expectEqual(@as(?u32, 1), layer_rows[0][0].missing_assignments);
+}
+
+test "causality observer: observer-off exposes no fake timing or LUT observations" {
+    selected = true;
+    observing = false;
+    active = true;
+    exported = false;
+    n_rounds = 0;
+    defer {
+        selected = false;
+        active = false;
+        in_round = false;
+    }
+    roundBegin(10, 7);
+    try std.testing.expect(current() == null);
+    roundEnd(&.{ 3, 4 }, 5, .{ .cycles = 1, .bonus_tokens = 1 });
+    try std.testing.expect(rounds[0].begin_ns == null);
+    try std.testing.expect(rounds[0].dt_ns == null);
+    try std.testing.expectEqual(@as(u32, 2), rounds[0].returned);
+}
diff --git a/src/arch/deepseek_v41/committed_tokens.zig b/src/arch/deepseek_v41/committed_tokens.zig
new file mode 100644
index 0000000..aa40c1c
--- /dev/null
+++ b/src/arch/deepseek_v41/committed_tokens.zig
@@ -0,0 +1,79 @@
+const std = @import("std");
+
+/// Raw token IDs represented by the live model state, excluding the next sampled correction.
+pub const Ledger = struct {
+    ids: std.ArrayList(u32) = .empty,
+    valid: bool = false,
+
+    pub fn deinit(self: *Ledger, a: std.mem.Allocator) void {
+        self.ids.deinit(a);
+        self.* = .{};
+    }
+
+    pub fn invalidate(self: *Ledger) void {
+        self.valid = false;
+    }
+
+    pub fn reset(self: *Ledger, a: std.mem.Allocator, tokens: []const u32, offset: u64) void {
+        self.valid = false;
+        self.ids.clearRetainingCapacity();
+        if (tokens.len != offset) return;
+        self.ids.appendSlice(a, tokens) catch return;
+        self.valid = true;
+    }
+
+    /// A failed forward or an incomplete commit disables promotion without failing generation.
+    pub fn append(self: *Ledger, a: std.mem.Allocator, before: u64, after: u64, tokens: []const u32, limit: u64) void {
+        if (!self.valid) return;
+        if (self.ids.items.len != before or after < before or after - before != tokens.len or after > limit) {
+            self.valid = false;
+            return;
+        }
+        self.ids.appendSlice(a, tokens) catch {
+            self.valid = false;
+        };
+    }
+
+    pub fn keep(self: *const Ledger, prefix: []const u32, offset: u64, saved_length: usize) u64 {
+        if (!self.valid or self.ids.items.len != offset or offset <= saved_length) return 0;
+        return boundaryKeep(self.ids.items, prefix);
+    }
+};
+
+pub fn boundaryKeep(boundary_ids: []const u32, prefix: []const u32) u64 {
+    const p = boundary_ids.len;
+    const keep = if (prefix.len >= p) p else if (prefix.len + 1 == p) p - 1 else return 0;
+    if (keep == 0) return 0;
+    return if (std.mem.eql(u32, boundary_ids[0..keep], prefix[0..keep])) keep else 0;
+}
+
+test "dsv41 answer checkpoint: committed blocks extend the matching boundary; unseen suffix and retokenized history fall back" {
+    const a = std.testing.allocator;
+    var ledger: Ledger = .{};
+    defer ledger.deinit(a);
+    ledger.reset(a, &.{ 1, 2, 3 }, 3);
+    ledger.append(a, 3, 6, &.{ 4, 5, 6 }, 32);
+    try std.testing.expectEqualSlices(u32, &.{ 1, 2, 3, 4, 5, 6 }, ledger.ids.items);
+    try std.testing.expectEqual(@as(u64, 6), ledger.keep(&.{ 1, 2, 3, 4, 5, 6, 8 }, 6, 3));
+    try std.testing.expectEqual(@as(u64, 5), ledger.keep(&.{ 1, 2, 3, 4, 5 }, 6, 3));
+    try std.testing.expectEqual(@as(u64, 0), ledger.keep(&.{ 1, 2, 3, 4, 9 }, 6, 3));
+    try std.testing.expectEqual(@as(u64, 0), ledger.keep(&.{ 1, 2, 3, 4 }, 6, 3));
+    try std.testing.expectEqual(@as(u64, 0), ledger.keep(&.{ 1, 2, 3, 4, 5, 6 }, 7, 3));
+}
+
+test "dsv41 answer checkpoint: failed or inconsistent forwards never promote; a new prompt resets the ledger" {
+    const a = std.testing.allocator;
+    var ledger: Ledger = .{};
+    defer ledger.deinit(a);
+    ledger.reset(a, &.{ 1, 2, 3 }, 3);
+    ledger.append(a, 3, 5, &.{4}, 32);
+    try std.testing.expect(!ledger.valid);
+    ledger.reset(a, &.{ 8, 9 }, 2);
+    ledger.append(a, 2, 3, &.{10}, 32);
+    try std.testing.expectEqual(@as(u64, 3), ledger.keep(&.{ 8, 9, 10, 11 }, 3, 2));
+    ledger.invalidate();
+    try std.testing.expectEqual(@as(u64, 0), ledger.keep(&.{ 8, 9, 10, 11 }, 3, 2));
+    ledger.reset(a, &.{ 8, 9 }, 2);
+    ledger.append(a, 2, 3, &.{10}, 2);
+    try std.testing.expect(!ledger.valid);
+}
diff --git a/src/arch/deepseek_v41/decode_attn_candidate.zig b/src/arch/deepseek_v41/decode_attn_candidate.zig
new file mode 100644
index 0000000..4e4319c
--- /dev/null
+++ b/src/arch/deepseek_v41/decode_attn_candidate.zig
@@ -0,0 +1,109 @@
+//! C04 experiment: reuse the registered corevec attention kernels for decode.
+//! No new Metal, weights, softmax, RoPE or quantization rule. Unsupported calls
+//! return null before launch so the caller keeps the qualified eager chain.
+const std = @import("std");
+const sdk = @import("sdk");
+const ops = @import("ops.zig");
+const kr = @import("kernel_routes.zig");
+const xk = @import("../../exl3/kernels.zig");
+const Dtype = ops.Dtype;
+
+pub fn enabledValue(profile: bool, value: ?[]const u8) bool {
+    return profile and value != null and std.mem.eql(u8, value.?, "1");
+}
+
+pub fn enabled() bool {
+    const value = if (std.c.getenv("DSV41_EXPERIMENT_INDEXED_DECODE_ATTN")) |v| std.mem.span(v) else null;
+    return enabledValue(sdk.plugin_profile, value);
+}
+
+const Format = struct { q: Dtype, kv: Dtype, cmp: bool };
+const formats = [_]Format{
+    .{ .q = .bfloat16, .kv = .bfloat16, .cmp = false },
+    .{ .q = .bfloat16, .kv = .float32, .cmp = false },
+    .{ .q = .float32, .kv = .bfloat16, .cmp = false },
+    .{ .q = .float32, .kv = .float32, .cmp = false },
+    .{ .q = .bfloat16, .kv = .bfloat16, .cmp = true },
+    .{ .q = .bfloat16, .kv = .float32, .cmp = true },
+    .{ .q = .float32, .kv = .float32, .cmp = true },
+};
+
+pub fn Set(comptime G: type) type {
+    return struct {
+        cores: [formats.len]?kr.PrefillAttn(G) = @splat(null),
+        pub fn init(g: *G, reg: *const xk.Registry, geo: *const kr.PrefillGeometry) !?@This() {
+            var self: @This() = .{};
+            errdefer self.deinit(g);
+            for (formats, 0..) |format, i| {
+                self.cores[i] = kr.PrefillAttn(G).init(g, reg, geo, .vec, format.q, format.kv, format.cmp, null) catch |err| switch (err) {
+                    error.RouteInput, error.TemplateNotRegistered => {
+                        self.deinit(g);
+                        return null;
+                    },
+                    else => return err,
+                };
+            }
+            return self;
+        }
+        pub fn deinit(self: *@This(), g: *G) void {
+            for (&self.cores) |*core| if (core.*) |*c| c.deinit(g);
+            self.cores = @splat(null);
+        }
+        pub fn tryAttend(self: *const @This(), g: *G, q: G.T, win: G.T, widx: G.T, wval: G.T, compressed: ?[2]G.T, sink: G.T) !?G.T {
+            const qs = g.shapeOf(q);
+            if (qs.n != 4 or qs.d[0] != 1 or qs.d[1] < 1 or qs.d[1] > 8 or qs.d[2] != 64 or qs.d[3] != 512) return null;
+            const ws = g.shapeOf(win);
+            if (ws.n != 3 or ws.d[0] != 1 or ws.d[1] < 1 or ws.d[2] != 512) return null;
+            const is = g.shapeOf(widx);
+            const vs = g.shapeOf(wval);
+            if (is.n != 2 or is.d[0] != qs.d[1] or is.d[1] != 128 or !is.eql(vs) or g.dtypeOf(widx) != .int32 or g.dtypeOf(wval) != .bool_) return null;
+            const ss = g.shapeOf(sink);
+            if (ss.n != 4 or ss.d[0] != 1 or ss.d[1] != 1 or ss.d[2] != 64 or ss.d[3] != 1 or g.dtypeOf(sink) != .float32) return null;
+            if (compressed) |cmp| {
+                const cs = g.shapeOf(cmp[0]);
+                const ci = g.shapeOf(cmp[1]);
+                if (cs.n != 3 or cs.d[0] != 1 or cs.d[1] < 1 or cs.d[2] != 512 or g.dtypeOf(cmp[0]) != g.dtypeOf(win)) return null;
