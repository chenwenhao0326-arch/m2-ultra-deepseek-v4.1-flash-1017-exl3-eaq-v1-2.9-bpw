diff --git a/src/arch/deepseek_v41/io_causality.zig b/src/arch/deepseek_v41/io_causality.zig
new file mode 100644
index 0000000..5ae7d0f
--- /dev/null
+++ b/src/arch/deepseek_v41/io_causality.zig
@@ -0,0 +1,59 @@
+//! Diagnostic tree only. Raw completion/read records; no sampling, scheduling, evaluation or synchronization change.
+const std = @import("std");
+pub const capacity: u32 = 131072;
+pub const Event = extern struct {
+    commit: u64,
+    kind: u64,
+    source: u64,
+    id: u64,
+    generation: u64,
+    related: u64,
+    begin_ns: i64,
+    end_ns: i64,
+    offset: i64,
+    bytes: i64,
+    result: i64,
+    flags: i64,
+    worker: i64,
+    fd: i64,
+};
+pub const storage_bytes: u64 = @as(u64, capacity) * @sizeOf(Event);
+extern fn q3ca_begin(cap: u32) c_int;
+extern fn q3ca_end() void;
+extern fn q3ca_info(out: *[8]u64) void;
+extern fn q3ca_get(index: u64, out: *Event) c_int;
+extern fn q3ca_now() i64;
+pub fn begin() !void {
+    if (q3ca_begin(capacity) != 0) return error.IoCaptureBusy;
+}
+pub fn end() void {
+    q3ca_end();
+}
+pub fn info() [8]u64 {
+    var out: [8]u64 = undefined;
+    q3ca_info(&out);
+    return out;
+}
+pub fn now() i64 {
+    return q3ca_now();
+}
+pub fn writeJson(w: anytype) !void {
+    const p = info();
+    try w.print("{{\"schema\":\"q3-io-causality-v1\",\"clock\":\"CLOCK_UPTIME_RAW_ns\",\"epoch\":{d},\"capacity\":{d},\"reserved\":{d},\"committed\":{d},\"pending\":{d},\"overflow\":{},\"active\":{},\"event_bytes\":{d},\"storage_bytes\":{d},\"fields\":[\"commit\",\"kind\",\"source\",\"id\",\"generation\",\"related\",\"begin_ns\",\"end_ns\",\"offset\",\"bytes\",\"result\",\"flags\",\"worker\",\"fd\"],\"events\":[", .{ p[0], p[1], p[2], p[3], p[4], p[5] != 0, p[6] != 0, p[7], storage_bytes });
+    var n: u64 = 0;
+    var missing: u64 = 0;
+    for (0..@min(p[1], p[2])) |i| {
+        var e: Event = undefined;
+        if (q3ca_get(i, &e) != 1) {
+            missing += 1;
+            continue;
+        }
+        try w.print("{s}[{d},{d},{d},{d},{d},{d},{d},{d},{d},{d},{d},{d},{d},{d}]", .{ if (n == 0) "" else ",", e.commit, e.kind, e.source, e.id, e.generation, e.related, e.begin_ns, e.end_ns, e.offset, e.bytes, e.result, e.flags, e.worker, e.fd });
+        n += 1;
+    }
+    try w.print("],\"emitted\":{d},\"missing\":{d},\"complete\":{}}}", .{ n, missing, p[6] == 0 and p[4] == 0 and p[5] == 0 and missing == 0 and n == p[2] });
+}
+test "causality IO ABI remains bounded" {
+    try std.testing.expectEqual(@as(usize, 112), @sizeOf(Event));
+    try std.testing.expect(storage_bytes <= 16 << 20);
+}
