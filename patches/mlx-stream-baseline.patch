diff --git a/src/arch/deepseek_v41/session_pool.zig b/src/arch/deepseek_v41/session_pool.zig
new file mode 100644
index 0000000..32f2522
--- /dev/null
+++ b/src/arch/deepseek_v41/session_pool.zig
@@ -0,0 +1,95 @@
+//! Small owning LRU. Values are MOVED in/out; never copied into a second live writer.
+const std = @import("std");
+const sdk = @import("sdk");
+pub const reserve_bytes: u64 = 2 << 30;
+pub const max_entries = 4;
+
+pub fn enabledValue(profile: bool, value: ?[]const u8) bool {
+    return profile and value != null and std.mem.eql(u8, value.?, "1");
+}
+pub fn enabled() bool {
+    if (comptime !sdk.plugin_profile) return false;
+    const raw = std.c.getenv("DSV41_EXPERIMENT_SESSION_RAM") orelse return false;
+    return enabledValue(true, std.mem.span(raw));
+}
+
+/// Value.deinit(g, allocator) releases everything the value owns, including CPU metadata.
+pub fn Pool(comptime Value: type) type {
+    return struct {
+        const Self = @This();
+        pub const Entry = struct { value: Value, bytes: u64, age: u64 };
+        slots: [max_entries]?Entry = @splat(null),
+        bytes: u64 = 0,
+        clock: u64 = 0,
+        limit: u64 = 0,
+
+        pub fn deinit(self: *Self, g: anytype, a: std.mem.Allocator) void {
+            for (0..self.slots.len) |i| self.evict(i, g, a);
+        }
+        pub fn evict(self: *Self, i: usize, g: anytype, a: std.mem.Allocator) void {
+            if (self.slots[i]) |*entry| {
+                entry.value.deinit(g, a);
+                self.bytes -= entry.bytes;
+                self.slots[i] = null;
+            }
+        }
+        /// A failed insertion does not consume the caller's value.
+        pub fn put(self: *Self, value: Value, bytes: u64, g: anytype, a: std.mem.Allocator) bool {
+            if (bytes == 0 or bytes > self.limit) return false;
+            while (true) {
+                var free: ?usize = null;
+                var oldest: ?usize = null;
+                for (self.slots, 0..) |entry, i| {
+                    if (entry) |e| {
+                        if (oldest == null or e.age < self.slots[oldest.?].?.age) oldest = i;
+                    } else if (free == null) free = i;
+                }
+                if (free != null and self.bytes <= self.limit - bytes) {
+                    self.clock +%= 1;
+                    self.slots[free.?] = .{ .value = value, .bytes = bytes, .age = self.clock };
+                    self.bytes += bytes;
+                    return true;
+                }
+                self.evict(oldest orelse return false, g, a);
+            }
+        }
+        pub fn take(self: *Self, i: usize) ?Value {
+            const entry = self.slots[i] orelse return null;
+            self.slots[i] = null;
+            self.bytes -= entry.bytes;
+            return entry.value;
+        }
+    };
+}
+
+test "S05 session RAM: strict opt-in ownership LRU exact budget and oversize refusal" {
+    for ([_]?[]const u8{ null, "", "0", "true", "2", "1 " }) |v| try std.testing.expect(!enabledValue(true, v));
+    try std.testing.expect(enabledValue(true, "1"));
+    try std.testing.expect(!enabledValue(false, "1"));
+    const V = struct {
+        id: usize,
+        pub fn deinit(v: *@This(), freed: *[8]u8, _: std.mem.Allocator) void {
+            freed[v.id] += 1;
+        }
+    };
+    var freed: [8]u8 = @splat(0);
+    var p: Pool(V) = .{ .limit = 100 };
+    const a = std.testing.allocator;
+    try std.testing.expect(p.put(.{ .id = 0 }, 60, &freed, a));
+    try std.testing.expect(p.put(.{ .id = 1 }, 40, &freed, a));
+    try std.testing.expectEqual(@as(u64, 100), p.bytes);
+    try std.testing.expect(!p.put(.{ .id = 2 }, 101, &freed, a));
+    try std.testing.expectEqual(@as(u8, 0), freed[2]); // caller still owns rejected value
+    var moved = p.take(0).?;
+    try std.testing.expectEqual(@as(usize, 0), moved.id);
+    try std.testing.expectEqual(@as(u8, 0), freed[0]);
+    try std.testing.expect(p.put(moved, 60, &freed, a));
+    try std.testing.expect(p.put(.{ .id = 3 }, 20, &freed, a)); // oldest is now id1, not moved id0
+    try std.testing.expectEqual(@as(u8, 1), freed[1]);
+    try std.testing.expectEqual(@as(u8, 0), freed[0]);
+    p.deinit(&freed, a);
+    p.deinit(&freed, a);
+    try std.testing.expectEqualSlices(u8, &.{ 1, 1, 0, 1, 0, 0, 0, 0 }, &freed);
+    try std.testing.expectEqual(@as(u64, 0), p.bytes);
+    _ = &moved;
+}
diff --git a/src/arch/deepseek_v41/session_spare.zig b/src/arch/deepseek_v41/session_spare.zig
new file mode 100644
index 0000000..c89b1ae
--- /dev/null
+++ b/src/arch/deepseek_v41/session_spare.zig
@@ -0,0 +1,84 @@
+//! Archive normalization of a ring's unused lazy scratch, never its live data.
+const std = @import("std");
+const kv = @import("../../sdk_ext/kv.zig");
+
+/// A ring's other slot is allocation scratch. Its current slot contains every retained row.
+/// Ring.append already allocates a missing other slot on the next compaction; Ring.snapshot uses
+/// the same one-slot representation. Keep materialized scratch unchanged. No eval or sync here.
+pub fn discardLazySpare(comptime G: type, g: *G, window: *kv.Lanes(G).Window, probe: anytype) u32 {
+    switch (window.*) {
+        .store => return 0,
+        .ring => |*r| {
+            const spare: u1 = 1 - r.cur;
+            const x = r.bufs[spare] orelse return 0;
+            if (probe.available(x)) return 0;
+            g.release(x);
+            r.bufs[spare] = null;
+            r.caps[spare] = 0;
+            return 1;
+        },
+    }
+}
+
+const RowOps = @import("../../sdk_ext/kv_testing.zig").RowOps;
+const Probe = struct {
+    missing: ?u32,
+    pub fn available(p: @This(), x: u32) bool {
+        return p.missing == null or p.missing.? != x;
+    }
+};
+
+test "S05 lazy spare: short ring archives without unused zero buffer and later compacts identically" {
+    const a = std.testing.allocator;
+    var g: RowOps = .{ .gpa = a };
+    defer g.deinit();
+    const L = kv.Lanes(RowOps);
+    const geo: kv.Geometry = .{ .route = .window_ring, .max_verify = 8, .slack = 8, .headroom = 64 };
+    var control: L.Window = .{ .ring = L.Ring.init(128, geo) };
+    var archived: L.Window = .{ .ring = L.Ring.init(128, geo) };
+    defer control.deinit(&g);
+    defer archived.deinit(&g);
+    try control.append(&g, try g.range(0, 41));
+    try archived.append(&g, try g.range(0, 41));
+    const current = archived.ring.cur;
+    const live = archived.ring.bufs[current];
+    const unused = archived.ring.bufs[1 - current].?;
+    const length = archived.ring.logicalLen();
+    try std.testing.expectEqual(@as(u32, 1), discardLazySpare(RowOps, &g, &archived, Probe{ .missing = unused }));
+    try std.testing.expectEqual(live, archived.ring.bufs[current]);
+    try std.testing.expectEqual(length, archived.ring.logicalLen());
+    try std.testing.expect(archived.ring.bufs[1 - current] == null);
+    try std.testing.expectEqual(@as(u32, 0), archived.ring.caps[1 - current]);
+    var pos: i64 = 41;
+    for ([_]i64{ 1, 6, 160, 7, 131, 3 }) |n| {
+        const rows = try g.range(pos, pos + n);
+        try control.append(&g, rows);
+        try archived.append(&g, rows);
+        pos += n;
+        try std.testing.expectEqual(control.ring.logicalLen(), archived.ring.logicalLen());
+        try std.testing.expectEqual(control.ring.drop, archived.ring.drop);
+        try std.testing.expectEqualSlices(i64, g.rows((try control.view(&g)).?), g.rows((try archived.view(&g)).?));
+    }
+    try control.truncateTo(&g, @intCast(pos - 3));
+    try archived.truncateTo(&g, @intCast(pos - 3));
+    try std.testing.expectEqualSlices(i64, g.rows((try control.view(&g)).?), g.rows((try archived.view(&g)).?));
+}
+
+test "S05 lazy spare: never drops a live slot, a materialized spare or a store" {
+    var g: RowOps = .{ .gpa = std.testing.allocator };
+    defer g.deinit();
+    const L = kv.Lanes(RowOps);
+    var w: L.Window = .{ .ring = L.Ring.init(128, .{ .route = .window_ring }) };
+    defer w.deinit(&g);
+    try w.append(&g, try g.range(0, 41));
+    const before = w.ring.bufs;
+    try std.testing.expectEqual(@as(u32, 0), discardLazySpare(RowOps, &g, &w, Probe{ .missing = w.ring.bufs[w.ring.cur] }));
+    try std.testing.expectEqual(before, w.ring.bufs);
+    try std.testing.expectEqual(@as(u32, 0), discardLazySpare(RowOps, &g, &w, Probe{ .missing = null }));
+    var store: L.Window = .{ .store = .{ .grow = L.Grow.init(64, null) } };
+    defer store.deinit(&g);
+    try store.append(&g, try g.range(0, 5));
+    const buf = store.store.grow.buf;
+    try std.testing.expectEqual(@as(u32, 0), discardLazySpare(RowOps, &g, &store, Probe{ .missing = buf }));
+    try std.testing.expectEqual(buf, store.store.grow.buf);
+}
