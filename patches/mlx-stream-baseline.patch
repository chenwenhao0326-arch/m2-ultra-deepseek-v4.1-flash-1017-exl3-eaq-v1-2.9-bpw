+test "long-prefix full-context envelope sweep" {
+    const dir = std.mem.span(std.c.getenv("DSV41_BILL_AUDIT") orelse return error.SkipZigTest);
+    const settings_path = std.mem.span(std.c.getenv("CAUSAL_MODEL_SETTINGS") orelse return error.SettingsPathMissing);
