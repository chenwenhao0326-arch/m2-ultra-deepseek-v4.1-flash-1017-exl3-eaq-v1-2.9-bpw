+    try std.testing.expect((try restore(a, io, &g, opt, &model, 255, 256, &ids, true, 2)) == null);
+    var ix = (try readIndex(a, io, opt)).?;
+    defer ix.deinit();
+    const datafile = try filePath(a, opt, ix.value.entries[0].file_sha);
+    defer a.free(datafile);
+    try cwd().writeFile(io, .{ .sub_path = datafile, .data = "broken" });
+    try std.testing.expect((try restore(a, io, &g, opt, &model, 256, 256, &ids, true, 2)) == null);
