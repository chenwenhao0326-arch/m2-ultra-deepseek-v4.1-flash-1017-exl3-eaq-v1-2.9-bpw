+// A failed bank call followed by another request preserves every output mapping.
+const FinalReviewRetryRoute = struct {
+    fail_once: bool = true,
+    fail_bank: ?u32 = null,
+    pub fn call(_: *@This(), g: *TraceOps, act: u32, rows: quant.PrefillRows, bank: BankArraysOf(u32)) !u32 {
+        var inner: EncRoute = .{};
+        return g.keep(try inner.call(g, act, rows, bank));
+    }
+    pub fn callParts(self: *@This(), g: *TraceOps, act: u32, rows: quant.PrefillRows, bank: BankArraysOf(u32), a: std.mem.Allocator, outs: *std.ArrayList(u32), pos: *std.ArrayList(u32)) !void {
+        if (self.fail_once and (self.fail_bank == null or self.fail_bank.? == bank.gate.code)) {
+            self.fail_once = false;
+            return error.FinalReviewInjectedPrefillParts;
+        }
+        var inner: EncRoute = .{};
+        const before = outs.items.len;
+        try inner.callParts(g, act, rows, bank, a, outs, pos);
+        for (outs.items[before..]) |x| _ = g.keep(x);
+    }
+    pub fn finish(_: *@This(), _: *TraceOps) !void {}
+};
+
+fn finalReviewRetry(clear_scratch: bool, deferred: bool) !void {
+    const a = testing.allocator;
+    var c = testConfig(64, 32, 1);
+    c.n_routed_experts = 30;
+    var src = try FakeSource.init(a, .{ .hidden = 64, .inter = 32, .n_experts = 30, .rows = &.{16}, .transient_rows = 2 * max_route_ids });
+    if (deferred) src.wide_depth = 2;
+    defer src.deinit();
+    var g = TraceOps.init(a);
+    defer g.deinit();
+    g.record_host = true;
+    g.track_live = true;
+    const Math = WithPrefillRoutes(TraceOps, TraceMath, FinalReviewRetryRoute);
+    var rr = [_]FinalReviewRetryRoute{.{}};
+    const Ex = ExpertsWith(TraceOps, FakeSource, Math, .{ .prefill = true });
+    var ex = try Ex.initWith(a, &g, &src, .{ .d = .{ .hidden = 64, .inter = 32 }, .routes = &rr }, &c, if (deferred) .{ .wide = .{ .seed = true, .hot_first = true, .depth = 2, .defer_base = true, .base_at_seed = true, .seed_aligned = true } } else .{});
+    if (deferred) rr[0].fail_bank = ex.banks[0][@backingInt(BankKind.transient)].?.gate.code;
+    defer ex.deinit();
+    const n: u32 = 10;
+    const k: u32 = 6;
+    var first_ids: [60]u16 = undefined;
+    var retry_ids: [60]u16 = undefined;
+    for (&first_ids, &retry_ids, 0..) |*old, *next, i| {
+        old.* = @intCast(((i / k) * 5 + (i % k) * 7) % 30);
+        next.* = @intCast((29 - old.*));
+    }
+    var script: Script = .{ .calls = &.{ &first_ids, &retry_ids } };
+    g.host_values = script.values();
+    const act = try g.input(&.{ @intCast(n), 64 }, .bfloat16);
+    const indices = try g.input(&.{ @intCast(n), @intCast(k) }, .int32);
+    try testing.expectError(error.FinalReviewInjectedPrefillParts, ex.at(0).routedParts(&g, act, indices));
+    const stale = ex.wide.call_pos.items.len;
+    try testing.expectEqual(@as(usize, 0), stale);
