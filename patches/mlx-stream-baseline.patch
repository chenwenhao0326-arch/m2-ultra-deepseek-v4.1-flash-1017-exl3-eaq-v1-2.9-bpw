diff --git a/src/arch/deepseek_v41/parked_ext.zig b/src/arch/deepseek_v41/parked_ext.zig
new file mode 100644
index 0000000..3b7f491
--- /dev/null
+++ b/src/arch/deepseek_v41/parked_ext.zig
@@ -0,0 +1,163 @@
+//! Short text request pool reuse policy. No allocation or GPU operations live here.
+const std = @import("std");
+const sdk = @import("sdk");
+pub const max_prompt_tokens: u64 = 256;
+pub const process_cap: u64 = 162 << 30;
+pub const box_target: u64 = 180 << 30;
+pub const metadata_bytes: u64 = 1 << 20;
+pub const Limits = struct { process: u64, box: u64 };
+/// User-authorized larger cache, still opt-in and checked against the native bill and live box usage.
+fn wide272Enabled() bool {
+    if (comptime !sdk.plugin_profile) return false;
+    const raw = std.c.getenv("DSV41_EXPERIMENT_WIDE_PARK") orelse return false;
+    return std.mem.eql(u8, std.mem.span(raw), "1");
+}
+pub fn limitsForRows(prefill: u32, decode: u32) Limits {
+    if (prefill == 128 and decode == 272 and wide272Enabled()) return .{ .process = 176 << 30, .box = 192 << 30 };
+    if (prefill == 128 and decode == 184) return .{ .process = 128 << 30, .box = 188 << 30 };
+    return .{ .process = process_cap, .box = box_target };
+}
+pub fn enabled() bool {
+    if (comptime !sdk.plugin_profile) return false;
+    const p = std.c.getenv("DSV41_EXPERIMENT_PARKED_EXT") orelse return false;
+    return std.mem.eql(u8, std.mem.span(p), "1");
+}
+pub const Incoming = struct {
+    total: u64,
+    max_tokens: u64,
+    host_context: u64,
+    image: bool,
+};
+/// Constructed only after a native boundary/prefix identity match, never from a client claim.
+pub const Query = struct { rows: u64, positions: u64 };
+pub fn longPrefixEnabled() bool {
+    if (comptime !sdk.plugin_profile) return false;
+    const raw = std.c.getenv("DSV41_EXPERIMENT_LONG_PREFIX_PARK") orelse return false;
+    return std.mem.eql(u8, std.mem.span(raw), "1");
+}
+pub const Refusal = enum { off, unknown_shape, image, long_prompt, long_query, query_mismatch, geometry, no_pool, ownership, process_budget, box_unknown, box_pressure };
+pub fn shapeRefusal(on: bool, incoming: ?Incoming, previous_image: bool, prefill: u32, decode: u32, layers: u32, experts: u32) ?Refusal {
+    if (!on) return .off;
+    const req = incoming orelse return .unknown_shape;
+    if (req.image or previous_image) return .image;
+    if (req.total == 0 or req.total > max_prompt_tokens) return .long_prompt;
+    const geometry = ((prefill == 182 or prefill == 200 or prefill == 208) and decode == 245) or (prefill == 128 and decode == 184) or (prefill == 128 and decode == 272 and wide272Enabled());
+    if (!geometry or layers != 40 or experts != 384) return .geometry;
+    return null;
+}
+
+/// Retain the existing cold/unknown gate. Long histories require an explicit,
+/// already-verified query shape plus a different full-position memory bill.
+pub fn queryShapeRefusal(on: bool, incoming: ?Incoming, previous_image: bool, prefill: u32, decode: u32, layers: u32, experts: u32, query: ?Query) ?Refusal {
+    const q = query orelse return shapeRefusal(on, incoming, previous_image, prefill, decode, layers, experts);
+    if (!on) return .off;
+    const req = incoming orelse return .unknown_shape;
+    if (req.image or previous_image) return .image;
+    if (q.rows == 0 or q.rows > max_prompt_tokens) return .long_query;
+    if (q.positions != req.total or q.positions < q.rows or req.host_context == 0 or q.positions > req.host_context) return .query_mismatch;
+    var short = req;
+    short.total = q.rows;
+    return shapeRefusal(on, short, previous_image, prefill, decode, layers, experts);
+}
+
+test "long-prefix park: verified query and actual attention positions are both required" {
+    const T = std.testing;
+    const req: Incoming = .{ .total = 14575, .max_tokens = 256, .host_context = 262144, .image = false };
+    const good: Query = .{ .rows = 16, .positions = 14575 };
+    try T.expect(queryShapeRefusal(true, req, false, 128, 184, 40, 384, good) == null);
+    try T.expectEqual(Refusal.long_prompt, queryShapeRefusal(true, req, false, 128, 184, 40, 384, null).?);
+    try T.expectEqual(Refusal.query_mismatch, queryShapeRefusal(true, req, false, 128, 184, 40, 384, .{ .rows = 16, .positions = 14576 }).?);
+    try T.expectEqual(Refusal.long_query, queryShapeRefusal(true, req, false, 128, 184, 40, 384, .{ .rows = 257, .positions = req.total }).?);
+    try T.expectEqual(Refusal.long_query, queryShapeRefusal(true, req, false, 128, 184, 40, 384, .{ .rows = 0, .positions = req.total }).?);
+    try T.expectEqual(Refusal.image, queryShapeRefusal(true, req, true, 128, 184, 40, 384, good).?);
+    try T.expectEqual(Refusal.geometry, queryShapeRefusal(true, req, false, 128, 185, 40, 384, good).?);
+    var unknown = req; unknown.host_context = 0;
+    try T.expectEqual(Refusal.query_mismatch, queryShapeRefusal(true, unknown, false, 128, 184, 40, 384, good).?);
+    var small_context = req; small_context.host_context = req.total - 1;
+    try T.expectEqual(Refusal.query_mismatch, queryShapeRefusal(true, small_context, false, 128, 184, 40, 384, good).?);
+}
+pub fn budgetRefusal(own_bound: u64, box_used: ?u64, possible_added: u64) ?Refusal {
+    return budgetRefusalWithLimits(own_bound, box_used, possible_added, .{ .process = process_cap, .box = box_target });
+}
+pub fn budgetRefusalWithLimits(own_bound: u64, box_used: ?u64, possible_added: u64, limits: Limits) ?Refusal {
+    if (own_bound > limits.process) return .process_budget;
+    const used = box_used orelse return .box_unknown;
+    if (possible_added > limits.box or used > limits.box - possible_added) return .box_pressure;
+    return null;
+}
+test "parked coexistence limits preserve strict process and positive host budgets" {
+    const T = std.testing;
+    const lim = limitsForRows(128, 184);
+    try T.expectEqual(@as(u64, 128 << 30), lim.process);
+    try T.expectEqual(@as(u64, 188 << 30), lim.box);
+    try T.expect(budgetRefusalWithLimits(123 << 30, 170 << 30, 18 << 30, lim) == null);
+    try T.expectEqual(Refusal.box_pressure, budgetRefusalWithLimits(123 << 30, (170 << 30) + 1, 18 << 30, lim).?);
+    try T.expectEqual(Refusal.process_budget, budgetRefusalWithLimits((128 << 30) + 1, 0, 0, lim).?);
+    try T.expectEqual(Refusal.box_unknown, budgetRefusalWithLimits(1, null, 0, lim).?);
+    try T.expectEqual(Refusal.box_pressure, budgetRefusalWithLimits(1, 0, std.math.maxInt(u64), lim).?);
+    const old = limitsForRows(200, 245);
+    try T.expectEqual(process_cap, old.process);
+    try T.expectEqual(box_target, old.box);
+}
+test "parked ext policy: full shape and strict geometric scope" {
+    const T = std.testing;
+    const req: Incoming = .{ .total = 256, .max_tokens = 262144, .host_context = 262144, .image = false };
+    try T.expect(shapeRefusal(true, req, false, 200, 245, 40, 384) == null);
+    try T.expect(shapeRefusal(true, req, false, 128, 184, 40, 384) == null);
+    try T.expectEqual(Refusal.geometry, shapeRefusal(true, req, false, 128, 185, 40, 384).?);
+    try T.expectEqual(Refusal.unknown_shape, shapeRefusal(true, null, false, 200, 245, 40, 384).?);
+    var x = req;
+    x.total = 257;
+    try T.expectEqual(Refusal.long_prompt, shapeRefusal(true, x, false, 200, 245, 40, 384).?);
+    x = req;
+    x.image = true;
+    try T.expectEqual(Refusal.image, shapeRefusal(true, x, false, 200, 245, 40, 384).?);
+    try T.expectEqual(Refusal.image, shapeRefusal(true, req, true, 200, 245, 40, 384).?);
+    try T.expectEqual(Refusal.geometry, shapeRefusal(true, req, false, 200, 270, 40, 384).?);
+}
+test "parked ext policy: positive global delta never credits current RSS or future frees" {
+    const T = std.testing;
+    try T.expect(budgetRefusal(151 << 30, 159 << 30, 20 << 30) == null);
+    try T.expectEqual(Refusal.box_pressure, budgetRefusal(151 << 30, (160 << 30) + 1, 20 << 30).?);
+    try T.expectEqual(Refusal.process_budget, budgetRefusal(process_cap + 1, 0, 0).?);
+    try T.expectEqual(Refusal.box_unknown, budgetRefusal(1, null, 1).?);
+    try T.expectEqual(Refusal.box_pressure, budgetRefusal(1, 0, std.math.maxInt(u64)).?);
+}
+
+/// One host prepare authorizes one restore entry; a cancelled request cannot lend its shape to another direct caller.
+pub fn consumeRestore(shape: ?Incoming, seen: *bool) ?Incoming {
+    if (seen.*) return null;
+    seen.* = true;
+    return shape;
+}
+test "parked ext policy: an abandoned restore cannot lend its shape to the next request" {
+    var seen = false;
+    const shape: Incoming = .{ .total = 38, .max_tokens = 256, .host_context = 262144, .image = false };
+    try std.testing.expect(consumeRestore(shape, &seen) != null);
+    try std.testing.expect(consumeRestore(shape, &seen) == null);
+    seen = false; // prepareIncomingRequest for a new host request
+    try std.testing.expect(consumeRestore(shape, &seen) != null);
+}
+
+// The row bank/owner operations are generic; only this exact larger geometry is newly admitted.
+test "parked ext wide272 opt-in still requires native process and live host budgets" {
+    if (comptime !sdk.plugin_profile) return error.SkipZigTest;
+    const Env = struct {
+        extern "c" fn setenv([*:0]const u8, [*:0]const u8, c_int) c_int;
+        extern "c" fn unsetenv([*:0]const u8) c_int;
+    };
+    _ = Env.unsetenv("DSV41_EXPERIMENT_WIDE_PARK");
+    const req: Incoming = .{ .total = 128, .max_tokens = 4096, .host_context = 262144, .image = false };
+    try std.testing.expectEqual(Refusal.geometry, shapeRefusal(true, req, false, 128, 272, 40, 384).?);
+    _ = Env.setenv("DSV41_EXPERIMENT_WIDE_PARK", "1", 1);
+    defer _ = Env.unsetenv("DSV41_EXPERIMENT_WIDE_PARK");
+    try std.testing.expect(shapeRefusal(true, req, false, 128, 272, 40, 384) == null);
+    try std.testing.expectEqual(Refusal.geometry, shapeRefusal(true, req, false, 128, 273, 40, 384).?);
+    const lim = limitsForRows(128, 272);
+    try std.testing.expectEqual(@as(u64, 176 << 30), lim.process);
+    try std.testing.expectEqual(@as(u64, 192 << 30), lim.box);
+    try std.testing.expect(budgetRefusalWithLimits(170 << 30, 177 << 30, 14 << 30, lim) == null);
+    try std.testing.expectEqual(Refusal.box_pressure, budgetRefusalWithLimits(170 << 30, 179 << 30, 14 << 30, lim).?);
+    try std.testing.expectEqual(Refusal.process_budget, budgetRefusalWithLimits((176 << 30) + 1, 0, 0, lim).?);
+    try std.testing.expectEqual(Refusal.box_unknown, budgetRefusalWithLimits(170 << 30, null, 0, lim).?);
+}
