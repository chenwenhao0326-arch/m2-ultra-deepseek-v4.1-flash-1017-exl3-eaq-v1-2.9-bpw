+            for (inputs[3..]) |x| {
+                const sh = g.shapeOf(x);
+                if (sh.n != 4 or sh.d[0] < 1 or sh.d[1] != 320 or sh.d[2] != 144 or sh.d[3] != (if (k_index == 1) @as(c_int, 32) else 48) or g.dtypeOf(x) != .int16) return null;
+            }
