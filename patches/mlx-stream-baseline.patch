+    var index = (try readIndex(a, io, opt)) orelse return null;
+    defer index.deinit();
+    // At most8 metadata headers, biggest matching boundary first. Bad snapshots are clean misses.
+    var order: [max_entries]usize = undefined;
+    for (index.value.entries, 0..) |_, i| order[i] = i;
+    const C = struct {
+        entries: []const Entry,
+        fn less(c: @This(), x: usize, y: usize) bool {
+            return c.entries[x].tokens > c.entries[y].tokens;
+        }
+    };
+    std.mem.sort(usize, order[0..index.value.entries.len], C{ .entries = index.value.entries }, C.less);
+    for (order[0..index.value.entries.len]) |i| {
+        const e = index.value.entries[i];
+        if (e.tokens > prefix.len + 1) continue;
+        if (e.tokens <= prefix.len) {
+            const key = digest(std.mem.sliceAsBytes(prefix[0..e.tokens]));
+            if (!std.mem.eql(u8, &key, e.key_sha)) continue;
+        }
+        const path = try filePath(a, opt, e.file_sha);
+        defer a.free(path);
+        var meta = readMetadata(a, io, path) catch continue;
+        defer meta.deinit();
+        const m = meta.value;
+        if (!validMeta(m, opt, context, max_kv, model) or m.seeded != seeded or m.offset != e.tokens) continue;
+        const metadata_key = digest(std.mem.sliceAsBytes(m.ids));
+        if (!std.mem.eql(u8, &metadata_key, e.key_sha)) continue;
+        const keep = tokens.boundaryKeep(m.ids, prefix);
+        if (keep == 0) continue;
+        const stat = cwd().statFile(io, path, .{}) catch continue;
+        if (stat.size != e.bytes or stat.size > max_file_bytes) continue;
+        const sha = hashFile(io, path) catch continue;
+        if (!std.mem.eql(u8, &sha, e.file_sha)) continue;
+        const mark = g.mark();
+        defer g.resetTo(mark);
+        return loadOne(a, g, model, path, m, keep, e.bytes, stages) catch |err| {
+            sdk.log.warn("NATIVE session SSD: invalid snapshot {s}; cold fallback\n", .{@errorName(err)});
+            continue;
+        };
+    }
+    return null;
+}
+
+test "session disk: scope and bounded digest validation" {
+    try std.testing.expect(validDigest("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"));
+    try std.testing.expect(!validDigest("../evil"));
+    try std.testing.expect(!validDigest("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"));
+    const a = digest(std.mem.sliceAsBytes(&[_]u32{ 1, 2, 3 }));
+    const b = digest(std.mem.sliceAsBytes(&[_]u32{ 1, 2, 4 }));
+    try std.testing.expect(!std.mem.eql(u8, &a, &b));
+}
+
+fn testRows(a: std.mem.Allocator, g: *G, n: u32, width: u32, base: u32, dtype: mlx.mlx_dtype) !G.T {
+    const values = try a.alloc(f32, @as(usize, n) * width);
+    defer a.free(values);
+    for (values, 0..) |*v, i| v.* = @as(f32, @floatFromInt((base + @as(u32, @intCast(i))) % 1009)) / 8.0;
+    const x = try g.hostArray(std.mem.sliceAsBytes(values), &.{ 1, @intCast(n), @intCast(width) }, .float32);
+    return if (dtype == .float32) x else g.astype(x, dtype);
+}
+const Expected = struct {
+    values: []f32,
+    dtype: mlx.mlx_dtype,
+    fn of(a: std.mem.Allocator, g: *G, x: G.T) !Expected {
+        const buf = try a.alloc(f32, mlx.mlx_array_size(x));
+        errdefer a.free(buf);
+        _ = try g.hostF32(try g.astype(x, .float32), buf);
+        return .{ .values = buf, .dtype = g.dtypeOf(x) };
+    }
+    fn check(e: Expected, a: std.mem.Allocator, g: *G, x: ?G.T) !void {
+        const value = x orelse return error.SnapshotExpectedArray;
+        try std.testing.expectEqual(e.dtype, g.dtypeOf(value));
+        const got = try Expected.of(a, g, value);
+        defer a.free(got.values);
+        try std.testing.expectEqualSlices(u8, std.mem.sliceAsBytes(e.values), std.mem.sliceAsBytes(got.values));
+    }
+};
+fn snapshotWindow(g: *G, snap: L.Window.Snap, active: L.Window) !?G.T {
+    return switch (snap) {
+        .ring => |r| if (r.len > 0) try L.rowsSlice(g, r.snapArray().?, 0, r.len) else null,
+        .store => |n| if (n > 0) try L.rowsSlice(g, (try active.view(g)).?, 0, n) else null,
+    };
+}
+
+test "session disk: actual typed file roundtrip restores wrapped complete state and detects damaged data" {
+    _ = std.c.getenv("DSV41_SESSION_DISK_GPU_TEST") orelse return error.SkipZigTest;
+    mlx.installErrorHandler();
+    const a = std.testing.allocator;
