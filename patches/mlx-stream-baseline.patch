+    const field = parsed.value.object.get("__metadata__") orelse return error.BadSnapshotHeader;
+    if (field != .object) return error.BadSnapshotHeader;
+    const metadata = field.object;
+    const value = metadata.get(meta_key) orelse return error.BadSnapshotHeader;
