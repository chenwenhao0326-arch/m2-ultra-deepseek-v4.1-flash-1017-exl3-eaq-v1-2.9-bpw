+        const lease = try s.borrowReadyBase(0, &.{ 1, 2 });
+        try expectServed(s, &sb, lease, &.{ 1, 2 });
+        s.release(lease);
+        try s.flush();
+    }
+    try s.awaitReadAhead(0);
+    if (!lease_on) try s.seedPrefill(0, ids);
+    const actual = try serve(s, 0, ids);
+    try expectServed(s, &sb, actual, ids);
+    s.release(actual);
+    try s.flush();
+    const pol = &s.layers[0].policy;
+    const stats_ = s.stats();
+    var result: ReadyPolicySnapshot = .{ .clock = pol.clock, .recency = undefined, .frequency = undefined, .slots = undefined, .routes = stats_.route_calls, .hits = stats_.expert_cache_hits, .misses = stats_.expert_cache_misses };
+    @memcpy(&result.recency, pol.recency);
+    @memcpy(&result.frequency, pol.prefill_freq);
+    @memcpy(&result.slots, pol.expert_to_slot);
+    return result;
+}
