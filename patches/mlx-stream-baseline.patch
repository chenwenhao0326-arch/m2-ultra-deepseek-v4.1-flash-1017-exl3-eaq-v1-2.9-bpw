+        errdefer if (hash) |*h| h.deinit(v.a);
+        if (m.hash) |h| {
+            hash = .{};
+            try hash.?.hist.ensureTotalCapacityPrecise(v.a, m.hash_capacity);
+            try hash.?.hist.appendSlice(v.a, h);
