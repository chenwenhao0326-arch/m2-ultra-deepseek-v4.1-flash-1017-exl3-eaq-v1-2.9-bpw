+        if (m.hash) |h| {
+            if (h.len != m.offset or m.hash_capacity < h.len or m.hash_capacity > 2 * @as(u64, l.max_kv) + 1024 or m.boundary_hash_len != m.boundary_offset) return error.EngramState;
