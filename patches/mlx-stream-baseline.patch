+const HitsFirstFailure = enum { none, ready, early, late, finish };
+fn hitsFirstLargeCpuCase(comptime parts: bool, width: u32, used_experts: u32, capacity: u32, depth: u8, max_rows: u32, failure: HitsFirstFailure) !void {
