+        for (v.boundary.caches, ds) |c, *o| o.* = .{ .window = try e.add(c.window), .offset = c.offset };
+        const main = try e.add(v.boundary.main_h);
+        return .{ .identity = id, .arrays = e.desc.items, .offset = v.state.offset, .max_len = v.state.max_len orelse return error.UnboundedState, .scratch_bytes = v.state.scratch.len, .layers = ls, .hash = if (v.state.hash) |h| h.hist.items else null, .hash_capacity = if (v.state.hash) |h| h.hist.capacity else 0, .boundary_offset = v.boundary.state.offset, .boundary_layers = bs, .boundary_hash_len = v.boundary.state.hash_len, .ids = v.boundary.ids, .draft = ds, .main_h = main, .vision = v.boundary.vision, .seeded = v.boundary.seeded, .ledger_ids = v.committed.ids.items, .ledger_capacity = v.committed.ids.capacity, .ledger_valid = v.committed.valid };
+    }
+};
+const Validator = struct {
+    m: *const Manifest,
+    l: Layout,
+    used: []bool,
+    total: u64 = 0,
+    fn arr(v: *Validator, r: Ref, rows: u32, width: u32, dt: Dtype) !void {
+        const i = r orelse {
+            if (rows != 0) return error.TensorMissing;
+            return;
+        };
+        if (i >= v.m.arrays.len or v.used[i]) return error.TensorReference;
+        v.used[i] = true;
+        const d = v.m.arrays[i];
+        if (!std.mem.eql(u32, &d.shape, &.{ 1, rows, width })) return error.TensorShape;
+        if (d.dtype != dt) return error.TensorDtype;
+        const bytes = try std.math.mul(u64, try std.math.mul(u64, rows, width), if (dt == .BF16) 2 else 4);
+        if (d.bytes != bytes) return error.TensorSize;
+        v.total = try std.math.add(u64, v.total, bytes);
+        if (v.total > record_limit) return error.RecordTooLarge;
+    }
+    fn ring(v: *Validator, r: Ring, width: u32, dt: Dtype, window: u32, offset: u32) !void {
+        if (r.window != window or r.cap_keep < window or r.base_phys_cap < r.cap_keep or r.phys_cap < r.len or r.len > v.l.max_kv + 1024 or r.drop > offset or r.drop + r.len != offset or r.phys_cap > v.l.max_kv + 1024 or r.base_phys_cap > v.l.max_kv + 1024) return error.RingGeometry;
+        for (r.bufs, r.caps) |b, cap| {
+            if (cap > v.l.max_kv + 1024 or (b == null) != (cap == 0)) return error.RingGeometry;
+            try v.arr(b, cap, width, dt);
+        }
+        if (r.len > 0 and (r.bufs[r.cur] == null or r.caps[r.cur] < r.len)) return error.RingGeometry;
+    }
+    fn grow(v: *Validator, s: Grow, width: u32, dt: Dtype, ratio: u32) !void {
+        const cap = kv.boundedCompCap(v.l.max_kv, ratio).?;
+        if (s.bounded_cap != cap or s.init_cap != cap or s.len > s.cap or s.cap > cap or (s.buf == null) != (s.cap == 0)) return error.GrowGeometry;
+        try v.arr(s.buf, s.cap, width, dt);
+    }
+    fn validate(v: *Validator) !void {
+        const m = v.m;
+        const l = v.l;
+        if (l.layers.len == 0 or l.layers.len > 128 or l.stages > 8 or m.arrays.len > 4096 or l.max_kv > (1 << 22)) return error.StateGeometry;
+        if (m.identity.format != 1 or m.layers.len != l.layers.len or m.boundary_layers.len != m.layers.len or m.offset > m.max_len or m.max_len > l.max_kv + 1024 or m.scratch_bytes != l.scratch_bytes or m.boundary_offset == 0 or m.boundary_offset > m.offset or m.ids.len != m.boundary_offset) return error.StateGeometry;
