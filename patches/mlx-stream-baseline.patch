+const HitsFirstTestRoute = struct {
+    var source: ?*FakeSource = null;
+    calls: [8]struct { at: usize, node: usize, rows: usize } = undefined,
+    n_calls: usize = 0,
+    n_finishes: usize = 0,
+    fail_call: ?usize = null,
+    fail_finish: ?usize = null,
+    graph_oom: ?*testing.FailingAllocator = null,
+    owner_oom: ?*testing.FailingAllocator = null,
+    oom_after: usize = 0,
+    oom_armed: bool = false,
