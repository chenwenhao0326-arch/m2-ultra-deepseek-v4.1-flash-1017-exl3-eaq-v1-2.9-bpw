+                try Verify.row(rows[row * 64 ..][0..3], q, expert, pol, base_code, transient_code, used_experts);
+            }
+        }
+        try testing.expectEqual(@as(usize, ids.len), ex.wide.pos.items.len);
+        const seen = try a.alloc(bool, ids.len);
+        defer a.free(seen);
+        @memset(seen, false);
+        for (ex.wide.pos.items) |q| {
+            try testing.expect(q < seen.len);
+            try testing.expect(!seen[q]);
+            seen[q] = true;
+        }
+        for (seen) |yes| try testing.expect(yes);
+        var first_wait: usize = src.log.items.len;
+        for (src.log.items, 0..) |event, i| if (event.kind == .wait_gu or event.kind == .wait_down) {
