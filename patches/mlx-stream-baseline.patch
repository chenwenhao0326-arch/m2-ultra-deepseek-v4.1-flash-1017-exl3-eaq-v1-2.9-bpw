+        const two = try g.input(&.{ 2, 4 }, .float32);
+        const loc = try g.input(&.{ 2, 2, 2 }, .int32);
+        h.state.outs = .{ g.keep(one), g.keep(two) };
+        return .{ .outs = &h.state.outs, .loc = loc };
+    }
