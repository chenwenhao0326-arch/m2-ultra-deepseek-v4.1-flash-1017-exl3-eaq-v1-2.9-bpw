+    const mc = try v41.Config.load(a, testing.io, dir, &diag);
+    const initial = try bill.servedBill(a, testing.io, &c, 0, 188 << 30, .{});
+    const pb = try bill.servedPrefillBill(&c, .{}, &mc, initial.variant);
+    const lm = c.dsv41LayerMajor();
+    const joined = bill.joinlessRoute(.{});
+    const first_logical = @as(u64, initial.decode_rows - initial.prefill_rows) * initial.persistentRowBytes();
+    const first_rounded = first_logical + @as(u64, initial.layers) * bank.n_components * module.grow_alloc_round_bytes;
+    const cold = try bill.parkedPromptBill(initial, pb, lm, joined, first_logical, first_rounded);
+    var maximum: u64 = cold.prefill_wave;
+    var witness: pe.Query = .{ .rows = 1, .positions = 1 };
+    var queries: u64 = 0;
