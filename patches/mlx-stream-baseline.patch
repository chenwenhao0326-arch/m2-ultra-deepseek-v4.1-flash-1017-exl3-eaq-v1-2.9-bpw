+            for (&out, 0..) |*o, i| {
+                var x = mlx.mlx_array_new();
+                mlx.check(mlx.mlx_vector_array_get(&x, ov, i)) catch |err| {
+                    _ = mlx.mlx_array_free(x);
+                    return err;
+                };
+                o.* = try g.adopt(x);
+            }
