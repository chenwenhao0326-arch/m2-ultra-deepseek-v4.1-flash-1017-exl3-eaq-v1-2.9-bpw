+    }
+};
+fn validate(a: std.mem.Allocator, m: *const Manifest, l: Layout, id: Identity) !void {
+    if (!std.meta.eql(m.identity, id) or id.format != 1) return error.IdentityMismatch;
+    const used = try a.alloc(bool, m.arrays.len);
+    defer a.free(used);
+    @memset(used, false);
+    var v: Validator = .{ .m = m, .l = l, .used = used };
+    try v.validate();
+}
+
+const Import = struct {
+    a: std.mem.Allocator,
+    g: *G,
+    map: mlx.mlx_map_string_to_array,
+    fn get(v: *Import, r: Ref) !?G.T {
+        const i = r orelse return null;
+        var name: [40]u8 = undefined;
+        const key = try std.fmt.bufPrintSentinel(&name, "a{d}", .{i}, 0);
+        var x = mlx.mlx_array_new();
+        errdefer _ = mlx.mlx_array_free(x);
+        try mlx.check(mlx.mlx_map_string_to_array_get(&x, v.map, key));
+        try mlx.check(mlx.mlx_array_eval(x));
+        return x;
+    }
+    fn ring(v: *Import, r: Ring) !L.Ring {
+        var out: L.Ring = .{ .window = r.window, .cap_keep = r.cap_keep, .phys_cap = r.phys_cap, .base_phys_cap = r.base_phys_cap, .caps = r.caps, .cur = r.cur, .len = r.len, .drop = r.drop };
+        errdefer out.deinit(v.g);
+        out.bufs[0] = try v.get(r.bufs[0]);
+        out.bufs[1] = try v.get(r.bufs[1]);
+        return out;
+    }
+    fn grow(v: *Import, s: Grow) !L.Store {
+        return .{ .grow = .{ .buf = try v.get(s.buf), .len = s.len, .cap = s.cap, .init_cap = s.init_cap, .bounded_cap = s.bounded_cap } };
+    }
+    fn layer(v: *Import, s: Layer) !M.Cache {
+        var out = M.Cache.init(.{ .ratio = @intCast(s.ratio), .kv_source = s.kv_source }, s.window_size, .{ .route = .bounded, .max_kv = s.bounded_max_kv });
+        errdefer out.deinit(v.g);
+        out.offset = s.offset;
+        out.window = .{ .ring = try v.ring(s.window) };
+        out.compress = try v.grow(s.compress);
+        out.index = try v.grow(s.index);
+        if (s.frontier) |f| {
+            var k = try v.ring(f.kv);
+            errdefer k.deinit(v.g);
+            const sc = try v.ring(f.score);
+            out.frontier = .{ .kv = .{ .ring = k }, .score = .{ .ring = sc } };
+        }
+        return out;
+    }
+    fn bound(v: *Import, b: LayerBoundary) !M.Cache.Boundary {
+        var out: M.Cache.Boundary = .{ .offset = b.offset, .window = .{ .ring = try v.ring(b.window) }, .compress = b.compress, .index = b.index };
+        errdefer out.deinit(v.g);
+        if (b.frontier) |f| {
+            var k = try v.ring(f.kv);
+            errdefer k.deinit(v.g);
+            const sc = try v.ring(f.score);
+            out.frontier = .{ .kv = .{ .ring = k }, .score = .{ .ring = sc } };
+        }
+        return out;
+    }
+    fn state(v: *Import, m: *const Manifest) !M.State {
+        const ls = try v.a.alloc(M.Cache, m.layers.len);
+        var n: usize = 0;
+        errdefer {
+            for (ls[0..n]) |*x| x.deinit(v.g);
+            v.a.free(ls);
+        }
+        for (m.layers) |l| {
+            ls[n] = try v.layer(l);
