+        } else try testing.expect(rr[0].calls[0].at > first_wait);
+        try testing.expectEqual(@as(u64, groups), src.stats().route_calls);
+    }
+    try testing.expectEqual(@as(usize, 0), src.liveCalls());
+    try testing.expectEqual(@as(usize, 0), src.held.items.len);
+    try testing.expectEqual(@as(usize, 0), ex.wide.kept.items.len);
+    try testing.expectEqual(@as(usize, 0), g.use_after_drop);
+    var live = g.live_kept.valueIterator();
+    while (live.next()) |count| try testing.expectEqual(@as(i32, 0), count.*);
+    try ex.flush();
+    for (src.calls) |call| try testing.expect(call.state == .free);
+}
