+const Export = struct {
+    a: std.mem.Allocator,
+    arrays: std.ArrayList(G.T) = .empty,
+    desc: std.ArrayList(Array) = .empty,
+    bytes: u64 = 0,
+    fn add(e: *Export, x: ?G.T) !Ref {
