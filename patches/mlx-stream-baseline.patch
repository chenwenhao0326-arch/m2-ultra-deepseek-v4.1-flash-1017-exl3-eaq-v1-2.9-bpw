+    try std.testing.expectEqual(@as(u64, 5), m.restorePrefix(ids[0..5]));
+    // A caller must not restore an image prefix then omit its image identity at prefill.
+    try std.testing.expectError(error.VisionPrefixIdentityMismatch, m.prefillVisionAt(5, ids[5..], 0, null));
+    m.prepareVisionIdentity(image, .{ .dspark = true, .prefix_cache = true });
+    try std.testing.expectEqual(@as(u64, 0), m.restorePrefix(ids[0..5]));
+    m.turn_boundary.?.seeded = true;
+    try std.testing.expectEqual(@as(u64, 5), m.restorePrefix(ids[0..5]));
+    m.prepareVisionIdentity(image, .{ .prefix_cache = true });
+    try std.testing.expectEqual(@as(u64, 0), m.restorePrefix(ids[0..5]));
+    // A same-image request with a different token prefix is still cold.
+    m.prepareVisionIdentity(image, .{ .dspark = true, .prefix_cache = true });
+    try std.testing.expectEqual(@as(u64, 0), m.restorePrefix(&.{ 10, 99, 99, 15, 12 }));
+    try std.testing.expect(m.requestDraftAllowed());
+    m.prepareVisionIdentity(null, .{});
+    try std.testing.expect(m.requestDraftAllowed());
+    try std.testing.expect(m.requestCacheAllowed());
+    try std.testing.expectEqual(@as(u32, 128), m.dspark_cfg.?.max_tokens);
+}
+
+test "dsv41 vision prefix: answer promotion rejects different image before accessing checkpoint state" {
+    const image: VisionIdentity = .{ .key = @splat(3), .offset = 1, .rows = 2, .width = 32 };
+    var ids = [_]u32{ 10, 99, 99, 11, 12, 13 };
+    var m = visionPrefixTestModule(&ids, image, true);
+    m.answer_checkpoint = true;
+    m.multiturn = true;
+    var changed = image;
+    changed.key[0] = 9;
+    m.prepareVisionIdentity(changed, .{ .dspark = true, .prefix_cache = true });
+    m.promoteAnswerBoundary(&ids);
+    try std.testing.expect(m.turn_boundary.?.vision.?.same(image));
+    try std.testing.expectEqual(@as(usize, ids.len), m.turn_boundary.?.ids.len);
+    try std.testing.expectEqual(@as(u64, 0), m.restorePrefix(&ids));
+}
+
+test "S05 session RAM: image identity draft offsets and incomplete snapshots reject before state moves" {
+    var ids = [_]u32{ 10, 99, 99, 11, 12, 13 };
+    const image: VisionIdentity = .{ .key = @splat(7), .offset = 1, .rows = 2, .width = 32 };
+    var st: M.State = .{ .offset = 6, .layers = &.{} };
+    var caches = [_]H.Cache{.{ .offset = 6 }};
+    var b: TurnBoundary = .{ .ids = &ids, .state = .{ .offset = 6, .layers = &.{}, .hash_len = 0 }, .vision = image, .seeded = true, .caches = &caches, .main_h = std.mem.zeroes(G.T) };
+    const gates: VisionGates = .{ .dspark = true, .prefix_cache = true };
+    try std.testing.expectEqual(@as(u64, 5), Module.archiveKeep(&st, &b, ids[0..5], image, gates, true, 1));
+    var other = image;
+    other.key[0] += 1;
+    try std.testing.expectEqual(@as(u64, 0), Module.archiveKeep(&st, &b, ids[0..5], other, gates, true, 1));
+    other = image;
+    other.offset += 1;
+    try std.testing.expectEqual(@as(u64, 0), Module.archiveKeep(&st, &b, ids[0..5], other, gates, true, 1));
+    try std.testing.expectEqual(@as(u64, 0), Module.archiveKeep(&st, &b, ids[0..5], null, gates, true, 1));
+    try std.testing.expectEqual(@as(u64, 0), Module.archiveKeep(&st, &b, ids[0..5], image, .{}, false, 1));
+    try std.testing.expectEqual(@as(u64, 0), Module.archiveKeep(&st, &b, ids[0..5], image, gates, true, 2));
+    caches[0].offset = 5;
+    try std.testing.expectEqual(@as(u64, 0), Module.archiveKeep(&st, &b, ids[0..5], image, gates, true, 1));
+    caches[0].offset = 6;
+    st.offset = 5;
+    try std.testing.expectEqual(@as(u64, 0), Module.archiveKeep(&st, &b, ids[0..5], image, gates, true, 1));
+    st.offset = 6;
+    b.state.hash_len = 1;
+    try std.testing.expectEqual(@as(u64, 0), Module.archiveKeep(&st, &b, ids[0..5], image, gates, true, 1));
+    b.state.hash_len = 0;
+    b.vision = null;
+    b.seeded = false;
+    b.caches = &.{};
+    b.main_h = null;
+    try std.testing.expectEqual(@as(u64, 5), Module.archiveKeep(&st, &b, ids[0..5], null, .{}, false, 0));
+    try std.testing.expectEqual(@as(u64, 0), Module.archiveKeep(&st, &b, &.{ 10, 99, 99, 11, 14 }, null, .{}, false, 0));
+}
+
+test "S05 session RAM: served restore ownership path is compiled without executing a model" {
+    std.mem.doNotOptimizeAway(&Module.restoreSession);
+}
+
+test "S05 session RAM: capacity billing counts sliced backing and accepts native max_len slack" {
+    const a = std.testing.allocator;
+    const cpu = mlx.mlx_default_cpu_stream_new();
+    defer _ = mlx.mlx_stream_free(cpu);
