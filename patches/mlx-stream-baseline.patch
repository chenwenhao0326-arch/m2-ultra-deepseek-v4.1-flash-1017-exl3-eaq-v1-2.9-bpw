+/// Conservative positive-only increment for the global gate. Current pool/residents already appear in boxUsed.
+/// No offset for old state, released scratch, allocator cache, or hypothetical future reclaim is credited.
+/// S05 is not a future backing allocation: restoreSession's fixed-slot put/take moves existing State/Boundary
+/// owners (or evicts), and archiveCharge only observes them. Prefix promotion precedes the boxUsed reading.
+/// New active KV/boundary allocations remain covered below; the full native Bill still reserves the2GiB pool.
+/// Every new request rechecks this gate, so no future request's new state is borrowed against this decision.
+pub fn parkedPossibleAdded(b: Bill, prompt_scratch: u64) u64 {
+    const p = b.prefillTerms();
+    const d = b.decodeTerms();
+    return prompt_scratch + @max(p.waves, d.waves) + @max(p.kv, d.kv) + @max(p.mlx_cache, d.mlx_cache) +
+        @max(p.mlx_cache_overshoot, d.mlx_cache_overshoot) + @max(p.prompt_state, d.prompt_state) +
+        @max(p.vision_workspace, d.vision_workspace) +
+        @max(p.engram_posted, d.engram_posted) + @max(p.wire_tables, d.wire_tables) +
+        @max(p.prompt_buffer_allowance, d.decode_buffer_allowance) + @max(p.host_reserve, d.host_reserve) +
+        @max(p.unbilled_overhead, d.unbilled_overhead);
+}
