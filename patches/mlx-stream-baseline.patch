--- /dev/null
+++ b/src/sdk_ext/full_q.zig
@@ -0,0 +1,173 @@
+//! Exact sampled proposals and rejection sampling for native DSpark.
+//! Reference: DeepInfer 9bd9cf2 models/mtp/dflash.py + layers/sampler.py.
+//! Keep OUR target filter order/ties, and do not copy DRAFT_PROB_PENALTY.
+//! Proposal, acceptance and correction use separate position-keyed streams.
+const std = @import("std");
+const acc = @import("acceptance.zig");
+
+pub const Sampling = struct { params: acc.Params, base: u64 };
+const proposal_key: u64 = 0xA0761D6478BD642F;
+
+pub fn proposalUniform(seed: u64, pos: u64) f32 {
+    return acc.drawV(seed ^ proposal_key, pos);
+}
+
+fn uniforms(g: anytype, n: c_int, sm: acc.Params, base: u64, proposal: bool, acceptance: bool) !@TypeOf(g.*).T {
+    var u: [acc.max_rows]f32 = undefined;
+    for (u[0..@intCast(n)], 0..) |*x, i| {
+        const pos = base + i + 1;
+        x.* = if (proposal) proposalUniform(sm.seed, pos) else if (acceptance) acc.drawU(sm.seed, pos) else acc.drawV(sm.seed, pos);
+    }
+    return g.hostArray(std.mem.sliceAsBytes(u[0..@intCast(n)]), &.{ n, 1 }, .float32);
+}
+
+fn drawRows(g: anytype, mass: anytype, u: @TypeOf(mass)) !@TypeOf(mass) {
+    const sh = g.shapeOf(mass);
+    const cum = try g.cumsum(mass, -1);
+    const total = try g.slice(cum, &.{ 0, sh.dim(1) - 1 }, &.{ sh.dim(0), sh.dim(1) }, &.{ 1, 1 });
+    return g.astype(try g.sum(try g.astype(try g.less(cum, try g.mul(u, total)), .int32), -1, false), .uint32);
+}
+
+pub fn Proposal(comptime T: type) type {
+    return struct { ids: T, probs: T };
+}
+
+/// Called after the Markov bias uses the PREVIOUS sampled proposal.
+pub fn propose(g: anytype, logits: anytype, sm: acc.Params, pos: u64) !Proposal(@TypeOf(logits)) {
+    const f = try acc.filteredRows(g, logits, sm);
+    return .{ .ids = try drawRows(g, f.p, try uniforms(g, 1, sm, pos - 1, true, false)), .probs = f.p };
+}
+
+/// Native proposals carry full q; lookup extensions are deterministic point masses.
+pub fn proposalRows(g: anytype, native: anytype, drafts: []const u32, n_native: u32) !@TypeOf(native) {
+    const vocab = g.shapeOf(native).dim(-1);
+    const native2 = try g.reshape(native, &.{ g.shapeOf(native).dim(1), vocab });
+    const first = try g.slice(native2, &.{ 0, 0 }, &.{ @intCast(n_native), vocab }, &.{ 1, 1 });
+    if (drafts.len == n_native) return first;
+    const rest = drafts[n_native..];
+    const ids = try g.hostArray(std.mem.sliceAsBytes(rest), &.{ @intCast(rest.len), 1 }, .uint32);
+    const cols = try g.reshape(try g.arange(0, @floatFromInt(vocab), 1, .uint32), &.{ 1, vocab });
+    const point = try g.astype(try g.equal(ids, cols), .float32);
+    return g.concat(&.{ first, point }, 0);
+}
+
+pub fn Decision(comptime T: type) type {
+    return struct { tok: T, accept: T, invalid: T };
+}
+
+/// q has one row per draft in THIS chunk; target may have an extra bonus row.
+pub fn verify(g: anytype, logits: anytype, sm: acc.Params, base: u64, drafts: []const u32, q: @TypeOf(logits)) !Decision(@TypeOf(logits)) {
+    const w = g.shapeOf(logits).dim(0);
+    const v = g.shapeOf(logits).dim(1);
+    const n: c_int = @intCast(drafts.len);
+    std.debug.assert(n > 0 and n <= w);
+    const f = try acc.filteredRows(g, logits, sm);
+    const p = try g.slice(f.p, &.{ 0, 0 }, &.{ n, v }, &.{ 1, 1 });
+    const ids = try g.hostArray(std.mem.sliceAsBytes(drafts), &.{ n, 1 }, .uint32);
+    const px = try g.takeAlongAxis(p, ids, -1);
+    const qx = try g.takeAlongAxis(q, ids, -1);
+    const zero = f.zero;
+    const one = try g.scalar(1, .float32);
+    const positive_q = try g.greater(qx, zero);
+    const ratio = try g.minimum(one, try g.div(px, try g.where(positive_q, qx, one)));
+    const accepted = try g.logicalAnd(positive_q, try g.less(try uniforms(g, n, sm, base, false, true), ratio));
+    const residual = try g.maximum(try g.sub(p, q), zero);
+    const mass = try g.sum(residual, -1, true);
+    // No epsilon bias: an impossible zero-mass rejection fails closed at the first reached rejection.
+    const invalid = try g.logicalOr(try g.lessEqual(qx, zero), try g.logicalAnd(try g.equal(accepted, try g.equal(one, zero)), try g.lessEqual(mass, zero)));
+    const corrected = try drawRows(g, residual, try uniforms(g, n, sm, base, false, false));
+    var tok = try g.where(try g.reshape(accepted, &.{n}), try g.reshape(ids, &.{n}), corrected);
+    if (w > n) {
+        const tail = try g.slice(f.p, &.{ n, 0 }, &.{ w, v }, &.{ 1, 1 });
+        tok = try g.concat(&.{ tok, try drawRows(g, tail, try uniforms(g, w - n, sm, base + @as(u64, @intCast(n)), false, false)) }, 0);
+    }
+    return .{ .tok = tok, .accept = try g.reshape(accepted, &.{n}), .invalid = try g.reshape(invalid, &.{n}) };
+}
+
+pub fn reference(p: []const f64, q: []const f64, draft: u32, u: f32, v: f32) !struct { accept: bool, tok: u32 } {
+    if (q[draft] <= 0) return error.InvalidProposal;
+    if (u < @min(1.0, p[draft] / q[draft])) return .{ .accept = true, .tok = draft };
+    var residual: [acc.ref_max_vocab]f64 = undefined;
+    var z: f64 = 0;
+    for (p, q, residual[0..p.len]) |a, b, *r| {
+        r.* = @max(a - b, 0);
+        z += r.*;
+    }
+    if (z <= 0) return error.InvalidSpeculativeResidual;
+    return .{ .accept = false, .tok = acc.draw(residual[0..p.len], v) };
+}
+
+test "full q: equal proposal accepts every draft; disjoint supports correct without penalty" {
+    const t = std.testing;
+    for (0..2) |i| {
+        const r = try reference(&.{ 0.5, 0.5 }, &.{ 0.5, 0.5 }, @intCast(i), 0.999, 0.3);
+        try t.expect(r.accept and r.tok == i);
+    }
+    const r = try reference(&.{ 0, 1 }, &.{ 1, 0 }, 0, 0.1, 0.8);
+    try t.expect(!r.accept and r.tok == 1);
+    try t.expectError(error.InvalidProposal, reference(&.{ 1, 0 }, &.{ 0, 1 }, 0, 0.2, 0.3));
+}
+
+test "full q: proposal and residual sampling preserve target distribution over independent seeds" {
+    const p = [_]f64{ 0.15, 0.65, 0.20 };
+    const q = [_]f64{ 0.55, 0.35, 0.10 };
+    var counts = [_]u32{ 0, 0, 0 };
+    var accepted: u32 = 0;
+    const n = 40_000;
+    for (0..n) |seed| {
+        const draft = acc.draw(&q, proposalUniform(seed, 37));
+        const r = try reference(&p, &q, draft, acc.drawU(seed, 37), acc.drawV(seed, 37));
+        counts[r.tok] += 1;
+        accepted += @intFromBool(r.accept);
+    }
+    for (p, counts) |expected, actual| try std.testing.expectApproxEqAbs(expected, @as(f64, @floatFromInt(actual)) / n, 0.012);
+    // sum min(p,q) = 0.60, independently of random stream identities.
+    try std.testing.expectApproxEqAbs(@as(f64, 0.60), @as(f64, @floatFromInt(accepted)) / n, 0.012);
+}
+
+test "full q: Metal rows match scalar oracle with filtering lookup and bonus" {
+    _ = std.c.getenv("DSV41_FULL_Q_GPU_TEST") orelse return error.SkipZigTest;
+    const mlx = @import("sdk").mlx;
+    const ops = @import("../arch/deepseek_v41/ops.zig");
+    const stream = mlx.mlx_default_gpu_stream_new();
+    defer _ = mlx.mlx_stream_free(stream);
+    var g = try ops.MlxOps.init(std.testing.allocator, stream);
+    defer g.deinit();
+    const logits = [_]f32{ 0.1, 1.1, -0.4, 0.7, 0.9, 0.1, 1.4, -0.2, 0.5, 1.9, 0.3, -0.7 };
+    const draft_logits = [_]f32{ 1.0, 0.3, -0.2, 0.7 };
+    for ([_]acc.Params{ .{ .temperature = 1 }, .{ .temperature = 0.7, .top_p = 0.8, .top_k = 3, .min_p = 0.1 } }) |params| {
+        for (0..12) |seed| {
+            var sm = params;
+            sm.seed = seed;
+            const lg = try g.hostArray(std.mem.sliceAsBytes(&logits), &.{ 3, 4 }, .float32);
+            const dl = try g.hostArray(std.mem.sliceAsBytes(&draft_logits), &.{ 1, 4 }, .float32);
+            const draft = try propose(&g, dl, sm, 101);
+            var ids: [1]u32 = undefined;
+            _ = try g.hostU32(draft.ids, &ids);
+            const drafts = [_]u32{ ids[0], 2 };
+            const q = try proposalRows(&g, try g.reshape(draft.probs, &.{ 1, 1, 4 }), &drafts, 1);
+            const result = try verify(&g, lg, sm, 100, &drafts, q);
+            var got: [3]u32 = undefined;
+            var accepted: [2]bool = undefined;
+            var invalid: [2]bool = undefined;
+            _ = try g.hostU32(result.tok, &got);
+            _ = try g.hostBool(result.accept, &accepted);
+            _ = try g.hostBool(result.invalid, &invalid);
+            var q0: [4]f64 = undefined;
+            acc.distribution(&draft_logits, sm, &q0);
+            try std.testing.expectEqual(acc.draw(&q0, proposalUniform(seed, 101)), ids[0]);
+            for (0..3) |i| {
+                var p: [4]f64 = undefined;
+                acc.distribution(logits[i * 4 ..][0..4], sm, &p);
+                if (i < 2) {
+                    const point = [_]f64{ 0, 0, 1, 0 };
+                    const oracle = try reference(&p, if (i == 0) &q0 else &point, drafts[i], acc.drawU(seed, 101 + i), acc.drawV(seed, 101 + i));
+                    try std.testing.expect(!invalid[i]);
+                    try std.testing.expectEqual(oracle.accept, accepted[i]);
+                    try std.testing.expectEqual(oracle.tok, got[i]);
+                } else try std.testing.expectEqual(acc.sample(&p, seed, 103), got[i]);
+            }
+            g.reset();
+        }
+    }
+}
