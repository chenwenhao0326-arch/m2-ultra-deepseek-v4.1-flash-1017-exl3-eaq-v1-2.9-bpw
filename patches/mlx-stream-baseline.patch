+        pub fn init() !Self {
+            var self: Self = .{};
+            if (comptime T != mlx.mlx_array) return self;
+            errdefer self.deinit();
+            const in_names = [_][*:0]const u8{ "xh_g", "xh_u", "ids", "code_g0", "code_g1", "code_g2", "code_u0", "code_u1", "code_u2" };
