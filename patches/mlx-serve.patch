+/// A process-local settings file for isolated service experiments. An invalid
+/// explicit path disables settings rather than falling back to a global file.
+pub fn selectedPath(buf: []u8, explicit: ?[]const u8, fallback: []const u8) []const u8 {
+    if (explicit) |path| {
+        if (!std.fs.path.isAbsolute(path) or path.len >= buf.len) return "";
+        @memcpy(buf[0..path.len], path);
+        return buf[0..path.len];
+    }
+    return fallback;
+}
+
 pub fn defaultPath(buf: []u8) []const u8 {
+    if (std.c.getenv("MLX_SERVE_MODEL_SETTINGS_PATH")) |value|
+        return selectedPath(buf, std.mem.span(value), "");
     return homeFile(buf, "model-settings.json");
 }
 
+test "model_settings: process-local override never falls back to global settings" {
+    var buf: [128]u8 = undefined;
+    try std.testing.expectEqualStrings("/project/state/settings.json", selectedPath(&buf, "/project/state/settings.json", "global"));
+    try std.testing.expectEqualStrings("", selectedPath(&buf, "relative.json", "global"));
+    try std.testing.expectEqualStrings("", selectedPath(&buf, "", "global"));
+    try std.testing.expectEqualStrings("global", selectedPath(&buf, null, "global"));
+    var small: [4]u8 = undefined;
+    try std.testing.expectEqualStrings("", selectedPath(&small, "/long/path", "global"));
+}
