+fn dsv41ToolRank(message: Message, calls: []const ToolCall) usize {
+    const id = message.tool_call_id orelse return 0;
+    for (calls, 0..) |call, rank| if (std.mem.eql(u8, id, call.id)) return rank;
+    return 0;
+}
