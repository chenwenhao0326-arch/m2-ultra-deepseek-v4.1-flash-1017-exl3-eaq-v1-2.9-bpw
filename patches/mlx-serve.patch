diff --git a/src/experiment_stream_rows.zig b/src/experiment_stream_rows.zig
new file mode 100644
index 0000000..2d7bcca
--- /dev/null
+++ b/src/experiment_stream_rows.zig
@@ -0,0 +1,35 @@
+//! Process-local row override for controlled, isolated benchmarks.
+//! Admission and the plugin's complete 256K memory bill remain authoritative.
+const std = @import("std");
+
+pub const Rows = struct { decode: u32, prefill: u32 };
+
+pub fn parse(decode: ?[]const u8, prefill: ?[]const u8) !?Rows {
+    if (decode == null and prefill == null) return null;
+    const d = try integer(decode orelse return error.InvalidExperimentalExpertRows);
+    const p = try integer(prefill orelse return error.InvalidExperimentalExpertRows);
+    if (p < 16 or p > d or d > 384) return error.InvalidExperimentalExpertRows;
+    return .{ .decode = d, .prefill = p };
+}
+
+fn integer(s: []const u8) !u32 {
+    if (s.len == 0) return error.InvalidExperimentalExpertRows;
+    for (s) |c| if (c < '0' or c > '9') return error.InvalidExperimentalExpertRows;
+    return std.fmt.parseInt(u32, s, 10) catch error.InvalidExperimentalExpertRows;
+}
+
+test "experiment rows: absent preserves the upstream planner and valid paired rows stay exact" {
+    try std.testing.expectEqual(@as(?Rows, null), try parse(null, null));
+    try std.testing.expectEqual(Rows{ .decode = 132, .prefill = 86 }, (try parse("132", "86")).?);
+    try std.testing.expectEqual(Rows{ .decode = 16, .prefill = 16 }, (try parse("16", "16")).?);
+    try std.testing.expectEqual(Rows{ .decode = 384, .prefill = 384 }, (try parse("384", "384")).?);
+}
+
+test "experiment rows: incomplete, invalid or out-of-range input refuses instead of silently replanning" {
+    for ([_][2]?[]const u8{
+        .{ "132", null },  .{ null, "86" },    .{ "", "86" },           .{ "132", "" },
+        .{ "abc", "86" },  .{ "132.0", "86" }, .{ "-1", "86" },         .{ "+132", "86" },
+        .{ "132 ", "86" }, .{ " 132", "86" },  .{ "132", "0" },         .{ "132", "15" },
+        .{ "85", "86" },   .{ "385", "86" },   .{ "4294967296", "86" },
+    }) |pair| try std.testing.expectError(error.InvalidExperimentalExpertRows, parse(pair[0], pair[1]));
+}
