+/// Sort only tool-result slots within each merged user-side group, preserving text/image positions.
+fn orderDsv41ToolMessages(allocator: std.mem.Allocator, messages: []const Message) ![]Message {
+    const out = try allocator.dupe(Message, messages);
+    errdefer allocator.free(out);
+    const positions = try allocator.alloc(usize, messages.len);
+    defer allocator.free(positions);
+    var calls: []const ToolCall = &.{};
+    var at: usize = 0;
+    while (at < out.len) {
+        const msg = out[at];
+        if (std.mem.eql(u8, msg.role, "assistant")) {
+            if (msg.tool_calls) |tc| if (tc.len > 0) {
+                calls = tc;
+            };
+            at += 1;
+            continue;
+        }
+        if (!std.mem.eql(u8, msg.role, "user") and !std.mem.eql(u8, msg.role, "tool")) {
+            at += 1;
+            continue;
+        }
+        var count: usize = 0;
+        while (at < out.len and (std.mem.eql(u8, out[at].role, "user") or std.mem.eql(u8, out[at].role, "tool"))) : (at += 1) {
+            if (std.mem.eql(u8, out[at].role, "tool")) {
+                positions[count] = at;
+                count += 1;
+            }
+        }
+        if (calls.len == 0) continue;
+        var k: usize = 1;
+        while (k < count) : (k += 1) {
+            const item = out[positions[k]];
+            var j = k;
+            while (j > 0 and dsv41ToolRank(out[positions[j - 1]], calls) > dsv41ToolRank(item, calls)) : (j -= 1) out[positions[j]] = out[positions[j - 1]];
+            out[positions[j]] = item;
+        }
+    }
+    return out;
 }
 
