@@ -0,0 +1,24 @@
+const std = @import("std");
+
+/// The host hashes evaluated contiguous f32 image rows, their absolute token position and
+/// geometry. Token IDs alone cannot distinguish two images occupying the same prompt span.
+pub fn key(offset: u64, rows: u64, width: u64, payload: []const u8) [32]u8 {
+    var hash = std.crypto.hash.sha2.Sha256.init(.{});
+    hash.update("dsv41-vision-rows-v1\x00");
+    var metadata: [24]u8 = undefined;
+    std.mem.writeInt(u64, metadata[0..8], offset, .little);
+    std.mem.writeInt(u64, metadata[8..16], rows, .little);
+    std.mem.writeInt(u64, metadata[16..24], width, .little);
+    hash.update(&metadata);
+    hash.update(payload);
+    return hash.finalResult();
+}
+
+test "vision identity binds rows shape position and values before prefix matching" {
+    const t = std.testing;
+    const original = key(197, 184, 5120, "image rows");
+    try t.expectEqualSlices(u8, &original, &key(197, 184, 5120, "image rows"));
+    try t.expect(!std.mem.eql(u8, &original, &key(198, 184, 5120, "image rows")));
+    try t.expect(!std.mem.eql(u8, &original, &key(197, 5120, 184, "image rows")));
+    try t.expect(!std.mem.eql(u8, &original, &key(197, 184, 5120, "other rows")));
+}
