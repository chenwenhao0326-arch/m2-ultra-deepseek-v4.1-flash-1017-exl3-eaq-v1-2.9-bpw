+++ b/src/vision_stream.zig
@@ -0,0 +1,60 @@
+const std = @import("std");
+const chat = @import("chat.zig");
+
+/// The first candidate supports one contiguous image span. Reject mismatched marker/encoder
+/// counts instead of rendering text for image positions that never received embeddings.
+pub fn spanOffset(prompt: []const u32, image_id: u32, rows: usize) !u64 {
+    if (rows == 0 or image_id == 0) return error.InvalidVisionSpan;
+    var first: ?usize = null;
+    var count: usize = 0;
+    for (prompt, 0..) |id, i| {
+        if (id != image_id) continue;
+        if (first == null) first = i;
+        if (i != first.? + count) return error.MultipleVisionSpansUnsupported;
+        count += 1;
+    }
+    if (count != rows) return error.VisionPlaceholderCountMismatch;
+    return @intCast(first.?);
+}
+
+/// An old image turn cannot be reconstructed as text: refuse it explicitly in this candidate.
+pub fn rejectReason(messages: []const chat.Message) ?[]const u8 {
+    var latest_user: ?usize = null;
+    for (messages, 0..) |m, i| if (std.mem.eql(u8, m.role, "user")) {
+        latest_user = i;
+    };
+    var images: usize = 0;
+    for (messages, 0..) |m, i| {
+        if ((m.videos != null and m.videos.?.len > 0) or (m.audio != null and m.audio.?.len > 0))
+            return "This DeepSeek vision candidate supports one image only; video/audio is not supported";
+        if (m.images) |imgs| {
+            if (imgs.len == 0) continue;
+            if (latest_user == null or latest_user.? != i)
+                return "This DeepSeek vision candidate does not support images in chat history; start a new image turn";
+            for (imgs) |img| {
+                if (img.tile_rows != 0) return "Tiled image inputs are not supported by this DeepSeek vision candidate";
+                images += 1;
+            }
+        }
+    }
+    if (images > 1) return "This DeepSeek vision candidate supports exactly one image per request";
+    return null;
+}
+
+test "vision stream span validates offset and all image placeholders" {
+    const t = std.testing;
+    try t.expectEqual(@as(u64, 2), try spanOffset(&.{ 1, 2, 99, 99, 99, 3 }, 99, 3));
+    try t.expectError(error.VisionPlaceholderCountMismatch, spanOffset(&.{ 1, 99, 99, 3 }, 99, 3));
+    try t.expectError(error.MultipleVisionSpansUnsupported, spanOffset(&.{ 99, 1, 99 }, 99, 2));
+    try t.expectError(error.InvalidVisionSpan, spanOffset(&.{}, 99, 0));
+}
+
+test "vision stream accepts one latest image and refuses history multiple and audio" {
+    const t = std.testing;
+    const img: chat.ImageData = .{ .pixels = &.{}, .width = 1, .height = 1 };
+    try t.expect(rejectReason(&.{.{ .role = "user", .content = "Text" }}) == null);
+    try t.expect(rejectReason(&.{.{ .role = "user", .content = "Image?", .images = &.{img} }}) == null);
+    try t.expect(rejectReason(&.{.{ .role = "user", .content = "", .images = &.{ img, img } }}) != null);
+    try t.expect(rejectReason(&.{ .{ .role = "user", .content = "", .images = &.{img} }, .{ .role = "assistant", .content = "A" }, .{ .role = "user", .content = "Again" } }) != null);
+    try t.expect(rejectReason(&.{.{ .role = "user", .content = "", .audio = &.{.{ .samples = &.{} }} }}) != null);
+}
