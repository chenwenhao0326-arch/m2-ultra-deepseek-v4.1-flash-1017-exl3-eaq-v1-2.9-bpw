+/// Same native full-context/workspace bill, retaining only a checked subset of
+/// per-layer extension owners. The caller must inventory each owner against its
+/// original geometry before supplying `retained`. All rounding remains charged
+/// for ALL layers; only absent persistent payload is removed from prompt slots.
+pub fn parkedSubsetBill(full: Bill, pb: v41.PrefillBill, layer_major: bool, joinless: bool, retained: expert_stream.PoolBytes, query: ?@import("parked_ext.zig").Query) !Bill {
+    if(full.decode_rows<full.prefill_rows)return error.ParkedBackingGeometry;
+    const maximum=@as(u64,full.decode_rows-full.prefill_rows)*full.persistentRowBytes();
+    const rounding=@as(u64,full.layers)*expert_bank.n_components*module.grow_alloc_round_bytes;
+    if(retained.logical>maximum or retained.backing<retained.logical or retained.backing>retained.logical+rounding or (retained.logical==0 and retained.backing!=0))return error.ParkedBackingGeometry;
+    var bill=if(query) |q| try parkedQueryBill(full,pb,layer_major,joinless,maximum,maximum+rounding,q)
+        else try parkedPromptBill(full,pb,layer_major,joinless,maximum,maximum+rounding);
+    bill.slot_prefill-=maximum-retained.logical;
+    return bill;
+}
+
