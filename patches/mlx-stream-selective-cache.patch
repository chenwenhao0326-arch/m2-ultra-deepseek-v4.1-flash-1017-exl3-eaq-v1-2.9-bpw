@@ -0,0 +1,128 @@
+//! Selective extension retention, based on Sushi b68302a dsv41_borrow.releaseCount.
+//! MIT reference is pinned under the research folder upstream-b68302a/LICENSE.
+//! This is only a release PLAN. Only a new live measurement can admit allocations.
+const std=@import("std");
+pub const PoolCost=struct{logical:u64,backing:u64};
+
+/// Plan against BOTH native process cost and box usage. `projector` supplies
+/// the unchanged native bill with only released persistent payload removed.
+/// Saturation is used only in this plan; the final gate must use real readings.
+pub fn releaseCountFor(pools:[]const PoolCost,box_used:?u64,added:u64,box_limit:u64,process_limit:u64,projector:anytype) ?usize {
+    const used=box_used orelse return null;
+    if(added>box_limit)return null;
+    var logical:u64=0;var backing:u64=0;
+    for(0..pools.len+1) |n| {
+        if(fits(used-|backing,added,box_limit) and projector.processAfterRemoving(logical)<=process_limit)return n;
+        if(n==pools.len)break;
+        logical+|=pools[n].logical;backing+|=pools[n].backing;
+    }
+    return null;
+}
+
+/// `pools` are in release order (latest layer first). Unknown box usage or an
+/// impossible positive increment is never converted into usable headroom.
+pub fn releaseCount(pools:[]const u64, box_used:?u64, added:u64, box_limit:u64) ?usize {
+    const used=box_used orelse return null;
+    if(added>box_limit)return null;
+    const maximum_used=box_limit-added;
+    if(used<=maximum_used)return 0;
+    const need=used-maximum_used;
+    var released:u64=0;
+    for(pools,0..) |bytes,i| {
+        released +|= bytes;
+        if(released>=need)return i+1;
+    }
+    return null;
+}
+
+pub fn fits(box_used:?u64,added:u64,limit:u64) bool {
+    const used=box_used orelse return false;
+    return added<=limit and used<=limit-added;
+}
+
+pub const Refresh=struct{used:?u64=null,waited_ms:u64=0,samples:u32=0};
+/// Darwin rate-limits host_statistics64 for ordinary processes (the SDK warns
+/// about2..10reads/s). A process-footprint fence does not refresh the box-wide
+/// cached counters. Space box reads at500ms; never turn expected frees into a
+/// lower used value. At most1second of additional waiting, as in author's
+/// waitForUnwire, before the caller re-plans against the reported real usage.
+pub fn refreshAfterRelease(context:anytype,before:?u64,freed:u64,added:u64,limit:u64) Refresh {
+    var result:Refresh=.{};
+    var last_sample:u64=0;
+    for(0..2) |_| {
+        const now=context.elapsedMs();
+        const due=last_sample+500;
+        if(now<due){context.wait(due-now);result.waited_ms+=due-now;}
+        result.used=context.read();result.samples+=1;
+        last_sample=context.elapsedMs();
+        if(fits(result.used,added,limit))break;
+        if(before) |old| if(result.used) |current| {
+            if(old-|current>=freed-freed/10)break;
+        };
+    }
+    return result;
+}
+
+test "partial park: global refresh waits for stale samples instead of discarding more owners" {
+    const Fake=struct{
+        time:u64=0,readings:[2]?u64,reads:usize=0,at:[2]u64=undefined,
+        pub fn elapsedMs(c:*@This())u64{return c.time;}
+        pub fn wait(c:*@This(),ms:u64)void{c.time+=ms;}
+        pub fn read(c:*@This())?u64{c.at[c.reads]=c.time;defer c.reads+=1;return c.readings[c.reads];}
+    };
+    var stale:Fake=.{.time=20,.readings=.{19,15}};
+    const r=refreshAfterRelease(&stale,19,4,5,20);
+    try std.testing.expectEqual(@as(?u64,15),r.used);
+    try std.testing.expectEqual(@as(u64,980),r.waited_ms);
+    try std.testing.expectEqualSlices(u64,&.{500,1000},&stale.at);
+    var already_waited:Fake=.{.time=800,.readings=.{15,15}};
+    const immediate=refreshAfterRelease(&already_waited,19,4,5,20);
+    try std.testing.expectEqual(@as(u64,0),immediate.waited_ms);
+    var slow:Fake=.{.time=800,.readings=.{19,15}};
+    _=refreshAfterRelease(&slow,19,4,5,20);
+    try std.testing.expectEqualSlices(u64,&.{800,1300},&slow.at);
+    var unknown:Fake=.{.readings=.{null,null}};
+    const invalid=refreshAfterRelease(&unknown,19,4,5,20);
+    try std.testing.expect(!fits(invalid.used,5,20));
+    var pressure:Fake=.{.readings=.{18,18}};
+    const grew=refreshAfterRelease(&pressure,19,4,5,20);
+    try std.testing.expect(!fits(grew.used,5,20));
+}
+
+test "partial park: plan matches the captured245310 pressure without changing limits" {
+    const each:u64=65*13315584;
+    const pools:[40]u64=@splat(each);
+    try std.testing.expectEqual(@as(?usize,8),releaseCount(&pools,195851862016,14928093704,190<<30));
+    try std.testing.expectEqual(@as(?usize,10),releaseCount(&pools,196935630848,14928093704,190<<30));
+    try std.testing.expectEqual(@as(?usize,0),releaseCount(&pools,180<<30,10<<30,190<<30));
+    try std.testing.expectEqual(@as(?usize,null),releaseCount(&pools,null,1,190<<30));
+    try std.testing.expectEqual(@as(?usize,null),releaseCount(&pools,0,(190<<30)+1,190<<30));
+    try std.testing.expectEqual(@as(?usize,null),releaseCount(&.{3,2},10,6,10));
+    try std.testing.expect(!fits(std.math.maxInt(u64),1,std.math.maxInt(u64)));
+    try std.testing.expect(fits(0,std.math.maxInt(u64),std.math.maxInt(u64)));
+}
+
+test "partial park: planned frees never satisfy the live allocation predicate" {
+    const planned=releaseCount(&.{4,4,4},19,5,20).?;
+    try std.testing.expectEqual(@as(usize,1),planned);
+    // The driver still owns the pages despite releasing one logical owner.
+    try std.testing.expect(!fits(19,5,20));
+    // Actual reads showing delayed reclamation, then another process growing.
+    try std.testing.expect(!fits(16,5,20));
+    try std.testing.expect(fits(15,5,20));
+    try std.testing.expect(!fits(18,5,20));
+    try std.testing.expectEqual(@as(?usize,1),releaseCount(&.{4,4},18,5,20));
+}
+
+test "partial park: native process limit can require more releases than box limit" {
+    const Projector=struct{
+        initial:u64=18,
+        floor:u64=6,
+        pub fn processAfterRemoving(p:@This(),bytes:u64)u64{return @max(p.floor,p.initial-|bytes);}
+    };
+    const pools=[_]PoolCost{.{.logical=3,.backing=4},.{.logical=3,.backing=4},.{.logical=3,.backing=4}};
+    try std.testing.expectEqual(@as(?usize,1),releaseCountFor(&pools,19,5,20,16,Projector{}));
+    try std.testing.expectEqual(@as(?usize,2),releaseCountFor(&pools,19,5,20,12,Projector{}));
+    try std.testing.expectEqual(@as(?usize,null),releaseCountFor(&pools,19,5,20,5,Projector{}));
+    try std.testing.expectEqual(@as(?usize,null),releaseCountFor(&pools,null,5,20,16,Projector{}));
+}
